{
  "name": "theme-joe-next",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "nodemon --config nodemon.json --exec 'astro build'",
    "build": "astro build && theme-package",
    "build:templates": "astro build",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "settings:defaults": "node --experimental-strip-types scripts/settings-defaults.ts",
    "format": "prettier --write .",
    "astro": "astro",
    "qa:shots": "node scripts/qa/screenshots.mjs",
    "qa:snapshot": "node scripts/qa/snapshot.mjs",
    "qa:diff": "node scripts/qa/snapshot.mjs --diff",
    "qa:a11y": "node scripts/qa/a11y.mjs",
    "qa:size": "node --experimental-strip-types scripts/qa/size.ts"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  },
  "dependencies": {
    "@swup/a11y-plugin": "5.2.1",
    "@swup/head-plugin": "2.3.1",
    "@swup/preload-plugin": "3.2.12",
    "@swup/progress-plugin": "3.2.0",
    "@swup/scripts-plugin": "2.1.0",
    "@swup/scroll-plugin": "4.0.0",
    "astro": "7.4.2",
    "exifr": "7.1.3",
    "photoswipe": "5.4.4",
    "qrcode": "1.5.4",
    "swiper": "14.3.0",
    "swup": "4.10.0",
    "tocbot": "4.36.8",
    "vconsole": "3.15.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.13.0",
    "@halo-dev/theme-package-cli": "1.1.1",
    "@iconify-json/lucide": "1.2.147",
    "@iconify-json/ri": "1.2.10",
    "@iconify-json/simple-icons": "1.2.100",
    "@iconify/utils": "3.1.7",
    "@types/qrcode": "1.5.6",
    "nodemon": "3.1.14",
    "playwright-core": "1.64.1",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
