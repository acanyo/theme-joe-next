---
/**
 * 文章列表项。依赖循环变量 `post` 与 `iter`（th:each="post, iter : ...")。
 * 首页列表项带进入视口动效（data-motion）。
 */
import { COMMENT_ENABLED, el } from "../../config/expressions";

interface Props {
  /** 是否启用首页列表动画设置 */
  reveal?: boolean;
}

const { reveal = false } = Astro.props;
const COVER =
  "post.spec.cover ?: (#strings.isEmpty(theme.config.home.default_thumbnail) ? (theme.config.home.random_thumbnail and not #strings.isEmpty(theme.config.home.random_thumbnail_api) ? theme.config.home.random_thumbnail_api + '?pageid=' + post.metadata.name : '') : theme.config.home.default_thumbnail)";
---

<li
  class="joe_list__item default"
  data-motion={reveal ? "" : undefined}
  th:with={`cover = \${${COVER}}`}
>
  <a
    th:if="${theme.config.home.thumbnail and not #strings.isEmpty(cover)}"
    th:href="@{${post.status.permalink}}"
    class="thumbnail"
    th:title="${post.spec.title}"
  >
    <img
      width="100%"
      height="100%"
      loading="lazy"
      th:src="${thumbnail.gen(cover, 'm')}"
      th:srcset="|${thumbnail.gen(cover, 's')} 400w, ${thumbnail.gen(cover, 'm')} 800w|"
      sizes="(max-width: 768px) 100vw, 400px"
      th:alt="${post.spec.title}"
      data-fallback="thumbnail"
    />
    <time
      th:datetime="${#dates.format(post.spec.publishTime, 'yyyy-MM-dd')}"
      th:text="${#dates.format(post.spec.publishTime, 'yyyy-MM-dd')}"
    ></time>
    <i class="joe-font joe-icon-picture" aria-hidden="true"></i>
  </a>
  <div class="information">
    <a
      th:href="@{${post.status.permalink}}"
      class="title"
      th:title="${post.spec.title}"
    >
      <span
        th:if="${post.spec.pinned}"
        class="badge"
        style="display: inline-block"
      >
        置顶
      </span>
      <span th:text="${post.spec.title}"></span>
    </a>
    <a
      class="abstract"
      th:href="@{${post.status.permalink}}"
      th:title="${post.status.excerpt}"
      th:text="${post.status.excerpt}"
    ></a>
    <div class="meta">
      <ul class="items">
        <li th:text="${#dates.format(post.spec.publishTime, 'yyyy-MM-dd')}"></li>
        <li>
          <i class="joe-font joe-icon-eye" aria-hidden="true"></i>
          <span th:text="${post.stats.visit}">0</span>
        </li>
        <li th:if={el(COMMENT_ENABLED)}>
          <i class="joe-font joe-icon-message" aria-hidden="true"></i>
          <span th:text="${post.stats.comment}">0</span>
        </li>
        <li>
          <i class="joe-font joe-icon-dianzan" aria-hidden="true"></i>
          <span th:text="${post.stats.upvote}">0</span>
        </li>
      </ul>
      <ul class="categories" th:unless="${#lists.isEmpty(post.categories)}">
        <li class="pcate" th:each="category : ${post.categories}">
          <svg
            class="icon"
            viewBox="0 0 1024 1024"
            width="15"
            height="15"
            aria-hidden="true"
          >
            <path
              d="M512.2 564.743a76.818 76.818 0 0 1-30.973-6.508L108.224 393.877c-26.105-11.508-42.56-35.755-42.927-63.272-.384-27.44 15.356-52.053 41.042-64.232l373.004-176.74c20.591-9.737 45.16-9.755 65.75.017L917.68 266.39c25.668 12.188 41.39 36.792 41.024 64.231-.384 27.5-16.821 51.73-42.908 63.237l-372.57 164.377a77.18 77.18 0 0 1-31.025 6.508zM139.843 329.592l370.213 163.241c1.291.56 3.018.567 4.345-.009l369.758-163.128-369.706-175.464v-.01c-1.326-.628-3.158-.636-4.502 0l-370.108 175.37zm748.015 1.858h.175-.175zM512.376 941.674c-10.348 0-20.8-2.32-30.537-6.997L121.05 778.624c-18.113-7.834-26.454-28.87-18.62-46.983 7.835-18.112 28.862-26.488 46.993-18.61l362.08 156.629 345.26-156.366c17.939-8.166 39.14-.253 47.324 17.746 8.166 17.964.227 39.157-17.729 47.324l-344.51 156.61c-9.196 4.449-19.281 6.7-29.471 6.7z"
              fill="var(--text-secondary)"
            ></path>
            <path
              d="M871.563 515.449L511.81 671.775 152.358 515.787v73.578a34.248 34.248 0 0 0 20.76 31.48l301.518 129.19c11.806 5.703 24.499 8.546 37.175 8.546s25.367-2.843 37.174-8.546L850.82 620.534a34.248 34.248 0 0 0 20.744-31.474V515.45z"
              fill="#ff6a18"
            ></path>
          </svg>
          <a
            class="link"
            th:href="@{${category.status.permalink}}"
            th:text="${category.spec.displayName}"
          ></a>
        </li>
      </ul>
    </div>
  </div>
</li>
