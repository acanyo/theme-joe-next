---
/** 首页「精选推荐」：一排图片卡片，每张可以是分类，也可以是自定义链接（设置 home.featured_items） */
import Icon from "../common/Icon.astro";
import { responsiveImage, SIZES } from "../../config/images";
/** 没有封面时轮流使用主题自带的 4 张封面（按卡片位置），避免几张卡片同一张图 */
const FALLBACK = "#theme.assets('/images/hot_cover' + (iter.index % 4 + 1) + '.jpg')";
/** 封面为空字符串时 ?: 不生效，用 isEmpty 判断 */
const cover = (expr: string) => `#strings.isEmpty(${expr}) ? ${FALLBACK} : ${expr}`;
---

<div class="joe_index__hot">
  <div class="joe_index__title">
    <ul class="joe_index__title-title default">
      <li class="item active" th:text="${theme.config.home.featured_title ?: '精选推荐'}">精选推荐</li>
    </ul>
    <div class="joe_index__title-notice" th:if="${theme.config.home.featured_more}">
      <a th:href="@{/categories}">
        <Icon name="category" />全部分类
      </a>
    </div>
  </div>
  <ul class="joe_index__hot-list hotlist">
    <th-block th:each="hot, iter : ${theme.config.home.featured_items}">
      <th-block th:switch="${hot.source}">
        <th-block
          th:case="'category'"
          th:with="category = ${categoryFinder.getByName(hot.category?.name)}"
        >
          <li class="item animated fadeIn" th:if="${category != null}">
            <a
              class="link"
              th:href="@{${category.status.permalink}}"
              th:title="${category.spec.displayName}"
            >
              <figure class="inner">
                <img
                  width="100%"
                  height="120"
                  class="image"
                  loading="lazy"
                  {...responsiveImage(cover("category.spec.cover"), SIZES.card, ["s", "m"])}
                  th:alt="${category.spec.displayName}"
                  data-fallback="thumbnail"
                />
                <figcaption
                  class="title"
                  th:text="${category.spec.displayName}"
                ></figcaption>
              </figure>
            </a>
          </li>
        </th-block>
        <li
          class="item animated fadeIn"
          th:case="'custom'"
          th:with="custom = ${hot.custom}"
        >
          <a
            class="link"
            th:href="${custom?.url}"
            th:title="${custom?.title}"
            target="_blank"
            rel="noopener noreferrer"
          >
            <figure class="inner">
              <img
                width="100%"
                height="120"
                class="image"
                loading="lazy"
                {...responsiveImage(cover("custom?.image"), SIZES.card, ["s", "m"])}
                th:alt="${custom?.title}"
                data-fallback="thumbnail"
              />
              <figcaption
                class="title"
                th:text="${custom?.title}"
              ></figcaption>
            </figure>
          </a>
        </li>
      </th-block>
    </th-block>
  </ul>
</div>
