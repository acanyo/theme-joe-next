---
/**
 * 首页「分类橱窗」（设置 home.showcase）：选中的分类各占一行，横向排开该分类最新的几篇文章。
 * 只在首页第一页、文章列表与分页之后显示。
 */
import Icon from "../common/Icon.astro";
import { coverOf } from "../../config/expressions";
import { responsiveImage } from "../../config/images";

const COUNT = "#conversions.convert(theme.config.home.showcase_count ?: 6, 'java.lang.Integer')";
const COVER = coverOf("post");
---

<section
  class="joe_showcase"
  aria-label="分类橱窗"
  th:if="${theme.config.home.showcase and not #lists.isEmpty(theme.config.home.showcase_categories) and posts.page == 1}"
>
  <th-block th:each="catName : ${theme.config.home.showcase_categories}">
    <th-block
      th:with={`category = \${categoryFinder.getByName(catName)}, rowPosts = \${postFinder.list({page: 1, size: ${COUNT}, categoryName: catName, sort: {'spec.publishTime,desc'}}).items}`}
    >
      <div class="joe_showcase__row" th:if="${category != null and not #lists.isEmpty(rowPosts)}">
        <div class="joe_index__title">
          <h2 class="joe_index__title-title">
            <span class="item active" th:text="${category.spec.displayName}"></span>
          </h2>
          <a class="more" th:href="@{${category.status.permalink}}">
            全部 <span th:text="${category.postCount}"></span> 篇<Icon name="chevron-down" />
          </a>
        </div>
        <ul class="joe_showcase__list">
          <li th:each="post : ${rowPosts}" th:with={`cover = \${${COVER}}`}>
            <a class="card" th:href="@{${post.status.permalink}}" th:title="${post.spec.title}">
              <span class="cover">
                <img
                  th:if="${not #strings.isEmpty(cover)}"
                  width="100%"
                  height="100%"
                  loading="lazy"
                  {...responsiveImage("cover", "200px", ["s", "m"])}
                  th:alt="${post.spec.title}"
                  data-fallback="thumbnail"
                />
              </span>
              <span class="title" th:text="${post.spec.title}"></span>
              <time
                class="time"
                th:datetime="${#dates.format(post.spec.publishTime, 'yyyy-MM-dd')}"
                th:text="${#dates.format(post.spec.publishTime, 'yyyy-MM-dd')}"
              ></time>
            </a>
          </li>
        </ul>
      </div>
    </th-block>
  </th-block>
</section>
