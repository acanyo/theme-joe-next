---
/** 首页轮播。数据来源：指定文章、热门文章、自定义项（设置 carousel.banner_data_group） */
import BannerSlide from "./BannerSlide.astro";

const RANDOM_COVER = (key: string) =>
  `(#strings.isEmpty(theme.config.home.default_thumbnail) ? (theme.config.home.random_thumbnail and not #strings.isEmpty(theme.config.home.random_thumbnail_api) ? theme.config.home.random_thumbnail_api + '?pageid=' + ${key} : '') : theme.config.home.default_thumbnail)`;
const POST_VARS =
  "cover = ${slidePost.spec.cover ?: " +
  RANDOM_COVER("slidePost.metadata.name") +
  "}, title = ${slidePost.spec.title}, excerpt = ${slidePost.status.excerpt}, href = ${slidePost.status.permalink}";
const HOT_QUERY =
  "postFinder.list({page: 1, size: #conversions.convert(slide.popular_count ?: 3, 'java.lang.Integer'), sort: {'stats.visit,desc'}}).items";
---

<div class="joe_index__banner">
  <div class="swiper" data-joe-banner>
    <div class="swiper-wrapper">
      <th-block th:each="slide : ${theme.config.home.carousel_slides}">
        <th-block th:switch="${slide.source}">
          <th-block
            th:case="'post'"
            th:with="slidePost = ${postFinder.getByName(slide.post)}"
          >
            <div
              class="swiper-slide"
              th:if="${slidePost != null}"
              th:with={POST_VARS}
            >
              <BannerSlide />
            </div>
          </th-block>
          <th-block th:case="'popular'">
            <div
              class="swiper-slide"
              th:each={`slidePost : \${${HOT_QUERY}}`}
              th:with={POST_VARS}
            >
              <BannerSlide />
            </div>
          </th-block>
          <th-block
            th:case="'custom'"
            th:with="custom = ${slide.custom}"
          >
            <div
              class="swiper-slide"
              th:with={
                "cover = ${custom?.image ?: " +
                RANDOM_COVER("custom?.title") +
                "}, title = ${custom?.title}, excerpt = ${custom?.subtitle}, href = ${custom?.url}"
              }
            >
              <BannerSlide />
            </div>
          </th-block>
        </th-block>
      </th-block>
    </div>
    <div
      class="swiper-pagination"
      th:if="${theme.config.home.carousel_dots}"
    ></div>
    <th-block th:if="${theme.config.home.carousel_draggable and theme.config.home.carousel_arrows}">
      <button
        type="button"
        class="swiper-button-next"
        aria-label="下一张"
      ></button>
      <button
        type="button"
        class="swiper-button-prev"
        aria-label="上一张"
      ></button>
    </th-block>
  </div>
</div>
