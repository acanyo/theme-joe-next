---
import Icon from "../common/Icon.astro";
/**
 * 首屏大图：背景图/视频、打字机标题、一言。文字效果由 features/big-banner.ts 驱动。
 * `fullscreen` 用于首页（占满首屏并显示向下按钮）。
 */
interface Props {
  fullscreen?: boolean;
  /** 非首页时显示的标题表达式 */
  title?: string;
}

const { fullscreen = false, title = "site.title" } = Astro.props;
const WAVES =
  '<svg id="EvanWaves" class="waves-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto" ><defs><path id="gentle-wave" d="M -160 44 c 30 0 58 -18 88 -18 s 58 18 88 18 s 58 -18 88 -18 s 58 18 88 18 v 44 h -352 Z" ></path></defs><g class="parallax"><use href="#gentle-wave" x="48" y="0"></use><use href="#gentle-wave" x="48" y="3"></use><use href="#gentle-wave" x="48" y="5"></use><use href="#gentle-wave" x="48" y="7"></use></g></svg>';
---

<div
  id="EvanBigBanner"
  class:list={["evan-big-banner", fullscreen && "is-fullscreen"]}
  data-joe-big-banner
  th:attr={`data-title=\${theme.config.home.hero_title ?: ${title}}, data-hitokoto=\${theme.config.home.hero_hitokoto}`}
>
  <video
    th:if="${not #strings.isEmpty(theme.config.home.hero_video)}"
    class="video"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    th:src="${theme.config.home.hero_video}"
  ></video>
  <div class="infomation">
    <!-- 首页：大图标题就是页面的一级标题；列表页的大图只是装饰，一级标题在内容区 -->
    {fullscreen ? (
      <h1
        id="EvanBigBanner_Title"
        class="title"
        th:text={`\${theme.config.home.hero_title ?: ${title}}`}
      ></h1>
    ) : (
      <div
        id="EvanBigBanner_Title"
        class="title"
        th:text={`\${theme.config.home.hero_title ?: ${title}}`}
      ></div>
    )}
    <div class="desctitle hitokoto_desctitle">
      <div id="HitokotoText" class="motto joe_motto hitokoto_text"></div>
      <div id="HitokotoForm" class="motto joe_motto hitokoto_form"></div>
    </div>
  </div>
  {fullscreen && (
    <a href="#indexPosition" class="evan-big-banner_goto" aria-label="向下滚动">
      <Icon name="chevrons-down" class="index-goto-icon" />
    </a>
  )}
  <section class="evan-big-banner_bottom" id="indexPosition" set:html={WAVES} />
</div>
