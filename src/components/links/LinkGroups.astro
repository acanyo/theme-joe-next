---
/**
 * 友链分组列表。`groups` 为当前作用域中的分组列表表达式：
 * 插件路由（links.html）使用模板变量 groups，自定义页面（page_links.html）使用 linkFinder.groupBy()。
 * 分组与链接的排序在前端按设置执行（features/link-sort.ts）。
 *
 * 卡片：左侧 Logo，右侧名称与一行描述；悬停时描边染上主题色。
 * 插件做过可访问性检测且结果为「不可访问」时，Logo 右下角显示一个灰点并加上提示。
 */
import Icon from "../common/Icon.astro";
import "../../styles/pages/links.css";

interface Props {
  groups: string;
}

const { groups } = Astro.props;
const ACCESS_STATE = "link.status?.verification?.access?.state?.name()";
---

<div
  class="joe_links"
  data-joe-links
  th:attr="data-group-sort=${theme.config.pages.links_group_order}, data-link-sort=${theme.config.pages.links_link_order}"
>
  <section
    class="links-group"
    th:each={`group : \${${groups}}`}
    th:if="${not #lists.isEmpty(group.links) and #annotations.getOrDefault(group, 'link_group_enable_show', 'true') != 'false'}"
    th:attr="data-sort=${#annotations.getOrDefault(group, 'link_group_sort_seq', '0')}, data-created=${group.metadata.creationTimestamp}"
  >
    <h2 class="links-group__title">
      <span th:text="${group.spec.displayName ?: '未分组'}"></span>
      <em th:text="${#lists.size(group.links)}"></em>
    </h2>
    <ul class="joe_detail__friends">
      <li
        class="joe_detail__friends-item"
        th:each="link : ${group.links}"
        th:if="${#annotations.getOrDefault(link, 'link_enable_show', 'true') != 'false'}"
        th:attr="data-sort=${#annotations.getOrDefault(link, 'link_sort_seq', '0')}, data-created=${link.metadata.creationTimestamp}"
        th:with={`accessState = \${${ACCESS_STATE}}`}
      >
        <a
          class="contain"
          th:href="${link.spec.url}"
          target="_blank"
          rel="noopener noreferrer"
          th:title="${link.spec.description ?: link.spec.displayName}"
          th:classappend="${accessState == 'INACCESSIBLE' ? 'is-offline' : ''}"
        >
          <span class="logo">
            <img
              width="44"
              height="44"
              loading="lazy"
              th:src="${link.spec.logo ?: theme.config.pages.links_fallback_logo}"
              th:alt="${link.spec.displayName}"
              th:attr="data-text-avatar=${link.spec.displayName}"
              data-fallback="link"
            />
            <i class="state" th:if="${accessState == 'INACCESSIBLE'}" title="最近一次检测无法访问"></i>
          </span>
          <span class="body">
            <span class="name sub-text" th:text="${link.spec.displayName}"></span>
            <span class="desc" th:text="${link.spec.description ?: link.spec.url}"></span>
          </span>
          <Icon name="external" class="go" />
        </a>
      </li>
    </ul>
  </section>
</div>
