---
/** 侧栏组件的统一外框（标题 + 内容） */
import Icon from "../common/Icon.astro";
import type { IconName } from "../../config/icons";

interface Props {
  /** 区块类名，如 "newest"、"tags-cloud" */
  variant: string;
  /** 图标名（config/icons.ts） */
  icon: IconName;
  /** 静态标题；需要动态标题时使用 titleExpr */
  title?: string;
  /** 标题的 SpEL 表达式（不含 `${}`） */
  titleExpr?: string;
  /** 「更多」链接 */
  moreHref?: string;
  id?: string;
  [attr: string]: unknown;
}

const { variant, icon, title, titleExpr, moreHref, id, ...rest } = Astro.props;
---

<section class:list={["joe_aside__item", variant]} id={id} {...rest}>
  <div class="joe_aside__item-title">
    <slot name="icon">
      <Icon name={icon} />
    </slot>
    {titleExpr ? (
      <span class="text" th:text={`\${${titleExpr}}`}></span>
    ) : (
      <span class="text">{title}</span>
    )}
    {moreHref && (
      <a class="tags_more" th:href={`@{${moreHref}}`}>
        更多<Icon name="chevron-right" />
      </a>
    )}
  </div>
  <slot />
</section>
