---
/**
 * 侧栏容器：按设置 `aside.widgets` 的顺序渲染组件。
 * 页面级开关（如 aside.enable_tags_aside）由各页面自行判断。
 */
import BloggerCard from "../blogger/BloggerCard.astro";
import CloudWidget from "./CloudWidget.astro";
import PostListWidget from "./PostListWidget.astro";
import SimpleWidget from "./SimpleWidget.astro";
---

<aside
  class="joe_aside"
  th:classappend="${theme.config.aside.position == 'left' ? 'pos_left' : ''}"
>
  <slot name="top" />
  <th-block th:each="widget : ${theme.config.aside.widgets}">
    <th-block th:switch="${widget.type}">
      <th-block th:case="'blogger'">
        <BloggerCard />
      </th-block>
      <th-block th:case="'notice'">
        <SimpleWidget type="notice" />
      </th-block>
      <th-block th:case="'donate'">
        <SimpleWidget type="reward" />
      </th-block>
      <th-block th:case="'image'">
        <SimpleWidget type="picture" />
      </th-block>
      <th-block th:case="'latest'">
        <PostListWidget kind="newest" />
      </th-block>
      <th-block th:case="'popular'">
        <PostListWidget kind="hot" />
      </th-block>
      <th-block th:case="'recent_popular'">
        <PostListWidget kind="recent" />
      </th-block>
      <th-block th:case="'life'">
        <SimpleWidget type="lifetime" />
      </th-block>
      <th-block th:case="'comments'">
        <SimpleWidget type="newreply" />
      </th-block>
      <th-block th:case="'tags'">
        <CloudWidget kind="tag" />
      </th-block>
      <th-block th:case="'categories'">
        <CloudWidget kind="category" />
      </th-block>
      <th-block th:case="'ad'">
        <SimpleWidget type="ads" />
      </th-block>
      <th-block th:case="'custom'">
        <SimpleWidget type="custom" />
      </th-block>
    </th-block>
  </th-block>
  <slot />
</aside>
