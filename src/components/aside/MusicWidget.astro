---
/** 侧栏网易云歌单（APlayer + Meting API，脚本按需加载，见 features/music.ts） */
import AsideCard from "./AsideCard.astro";
---

<AsideCard
  variant="music"
  icon="yinfu"
  title="我的歌单"
  th:if="${not #strings.isEmpty(widget.music?.playlist)}"
>
  <div class="joe_aside__item-contain">
    <div
      class="aplayer"
      data-joe-music
      th:attr="data-id=${widget.music.playlist}"
      data-server="netease"
      data-type="playlist"
    ></div>
  </div>
</AsideCard>
