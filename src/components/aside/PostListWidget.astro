---
/** 侧栏文章列表卡片：最新文章 / 热门文章 / 近期热门（各占一张卡片） */
import AsideCard from "./AsideCard.astro";
import PostListItems, { type PostListKind } from "./PostListItems.astro";

interface Props {
  kind: PostListKind;
}

const { kind } = Astro.props;
const TITLES: Record<PostListKind, string> = { newest: "最新文章", hot: "热门文章", recent: "近期热门" };
---

<AsideCard variant="newest" icon="hot" title={TITLES[kind]}>
  <div class="joe_aside__item-contain">
    <PostListItems kind={kind} />
  </div>
</AsideCard>
