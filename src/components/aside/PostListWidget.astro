---
/** 侧栏文章列表：最新文章 / 热门文章 */
import AsideCard from "./AsideCard.astro";
import Icon from "../common/Icon.astro";

interface Props {
  kind: "newest" | "hot";
}

const { kind } = Astro.props;
const SOURCES = {
  newest: {
    title: "最新文章",
    size: "theme.config.aside.latest_count",
    sort: "'spec.publishTime,desc'",
  },
  hot: {
    title: "热门文章",
    size: "theme.config.aside.popular_count",
    sort: "'stats.visit,desc'",
  },
};
const source = SOURCES[kind];
const query = `postFinder.list({page: 1, size: #conversions.convert(${source.size} ?: 5, 'java.lang.Integer'), sort: {${source.sort}, 'metadata.creationTimestamp,asc'}})`;
---

<AsideCard variant="newest" icon="hot" title={source.title}>
  <div class="joe_aside__item-contain">
    <ul class="list" th:with={`asidePosts = \${${query}}`}>
      <li class="item" th:each="asidePost : ${asidePosts.items}">
        <a
          class="link"
          th:href="@{${asidePost.status.permalink}}"
          th:text="${asidePost.spec.title}"
        ></a>
        <Icon name="link" />
      </li>
    </ul>
  </div>
</AsideCard>
