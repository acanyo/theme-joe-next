---
/** 页脚：导航链接组与社交图标、版权、备案、Powered by、云服务商、运行时间与建站纪念、RSS/站点地图、访问统计 */
import Icon from "../common/Icon.astro";
import SocialLinks from "../blogger/SocialLinks.astro";
const CLOUD_PROVIDERS = [
  { key: "aliyun", url: "https://www.aliyun.com" },
  { key: "tencent", url: "https://cloud.tencent.com" },
  { key: "baidu", url: "https://cloud.baidu.com" },
  { key: "upyun", url: "https://www.upyun.com" },
  { key: "qiniu", url: "https://www.qiniu.com" },
  { key: "huawei", url: "https://www.huaweicloud.com" },
  { key: "jinshan", url: "https://www.ksyun.com" },
];
---

<footer
  class="joe_footer"
  th:if="${theme.config.footer.enabled}"
  th:classappend="|${theme.config.footer.position == 'fixed' ? 'fixed' : ''} ${theme.config.footer.full_width ? 'full' : ''}|"
>
  <!-- 页脚导航（设置 footer.nav）：左侧站点名、座右铭与社交图标，右侧几组链接 -->
  <nav
    class="joe_container joe_footer__nav"
    aria-label="页脚导航"
    th:if="${theme.config.footer.nav}"
  >
    <div class="brand">
      <a class="name" th:href="@{/}" th:text="${site.title}"></a>
      <p
        class="motto"
        th:if="${not #strings.isEmpty(theme.config.blogger.motto)}"
        th:text="${theme.config.blogger.motto}"
      ></p>
      <th-block th:if="${theme.config.footer.nav_social}">
        <SocialLinks />
      </th-block>
    </div>
    <div class="groups" th:unless="${#lists.isEmpty(theme.config.footer.nav_groups)}">
      <div class="group" th:each="group : ${theme.config.footer.nav_groups}">
        <h2 class="title" th:text="${group.title}"></h2>
        <ul>
          <li th:each="link : ${group.links}">
            <a
              th:href="${link.url}"
              th:text="${link.name}"
              th:attr="target=${#strings.startsWith(link.url, 'http') ? '_blank' : null}, rel=${#strings.startsWith(link.url, 'http') ? 'noopener noreferrer' : null}"
            ></a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
  <!-- 建站纪念（设置 footer.anniversary）：上下两部分之间的分隔线兼进度条，从起始时间到第 N 年，由 features/footer.ts 填充 -->
  <div
    class="joe_container joe_footer__progress"
    th:if="${theme.config.footer.uptime and theme.config.footer.anniversary}"
    aria-hidden="true"
  >
    <span class="track"><span class="fill"></span></span>
  </div>
  <div class="joe_container joe_footer__bar">
    <!-- 左列：运行时间与纪念文字、版权与备案、云服务商、公安备案 -->
    <div class="meta">
      <p class="site_life" th:if="${theme.config.footer.uptime}">
        <Icon name="runtime" />已运行
        <strong class="joe_run__day">00</strong>天
        <strong class="joe_run__hour">00</strong>时
        <strong class="joe_run__minute">00</strong>分
        <strong class="joe_run__second">00</strong>秒
        <span
          class="site_anniversary"
          th:if="${theme.config.footer.anniversary}"
          th:attr="data-years=${theme.config.footer.anniversary_years ?: 10}, data-label=${theme.config.footer.anniversary_label ?: '十年之约'}"
          hidden
        ></span>
      </p>
      <p>
        ©
        <span th:text="${#strings.isEmpty(theme.config.footer.since) ? '' : #strings.substring(theme.config.footer.since, 0, 4) + ' - '}"></span>
        <span th:text="${#dates.year(#dates.createNow())}"></span>&nbsp;<a th:href="${site.url}" th:text="${site.title}"></a>
        <th-block th:if="${theme.config.footer.icp and not #strings.isEmpty(theme.config.footer.filing?.icp)}">
          <span class="sep">·</span>
          <a
            class="icp"
            th:href="${theme.config.footer.filing.icp_link ?: 'https://beian.miit.gov.cn/'}"
            target="_blank"
            rel="noopener noreferrer nofollow"
            th:text="${theme.config.footer.filing.icp}"
          ></a>
        </th-block>
      </p>
      <p
        class="site_driven"
        th:if="${theme.config.footer.cloud != null and theme.config.footer.cloud != 'none'}"
      >
        本站点由
        <th-block th:switch="${theme.config.footer.cloud}">
          {CLOUD_PROVIDERS.map((p) => (
            <a
              th:case={`'${p.key}'`}
              href={p.url}
              target="_blank"
              rel="noopener noreferrer nofollow"
            >
              <img
                class={p.key}
                th:src={`@{/assets/images/cloud/${p.key}.svg}`}
                alt="云服务商"
                data-fallback="image"
              />
            </a>
          ))}
          <a
            th:case="'custom'"
            th:href="${theme.config.footer.cloud_url}"
            target="_blank"
            rel="noopener noreferrer nofollow"
          >
            <img
              class="custom"
              th:src="${theme.config.footer.cloud_logo}"
              alt="云服务商"
              data-fallback="image"
            />
          </a>
        </th-block>
        提供云服务
      </p>
      <p
        class="site_police"
        th:if="${theme.config.footer.police and not #strings.isEmpty(theme.config.footer.filing?.police)}"
      >
        <a
          th:href="${theme.config.footer.filing.police_link ?: 'https://beian.mps.gov.cn/#/query/webSearch'}"
          target="_blank"
          rel="noopener noreferrer nofollow"
          th:text="${theme.config.footer.filing.police}"
        ></a>
      </p>
    </div>
    <!-- 右列：RSS / 站点地图、Powered by、访问统计 -->
    <div class="side">
      <p class="feeds" th:if="${theme.config.footer.rss or theme.config.footer.sitemap}">
        <a
          th:if="${theme.config.footer.rss}"
          class="rss"
          th:href="@{/rss.xml}"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="rss" />RSS
        </a>
        <span class="sep" th:if="${theme.config.footer.rss and theme.config.footer.sitemap}">·</span>
        <a
          th:if="${theme.config.footer.sitemap}"
          th:href="@{/sitemap.xml}"
          target="_blank"
          rel="noopener noreferrer"
        >
          站点地图
        </a>
      </p>
      <p class="site_powered" th:if="${theme.config.footer.powered_by}">
        Powered by&nbsp;<a
          class="a-powered"
          href="https://www.halo.run/"
          target="_blank"
          rel="noopener noreferrer"
        >Halo</a>
        <span class="sep">·</span>
        Theme&nbsp;<a
          class="a-theme"
          th:href="${theme.spec.repo}"
          th:title="|${theme.spec.displayName} v${theme.spec.version}|"
          target="_blank"
          rel="noopener noreferrer"
        >Joe Next</a>
      </p>
      <div
        class="busuanzi-statistic"
        th:if="${theme.config.footer.busuanzi}"
      >
        <span class="site-pv">
          <Icon name="page-views" />访问量
          <em id="busuanzi_value_site_pv">0</em>
        </span>
        <span class="site-uv">
          <Icon name="visitors" />访客量
          <em id="busuanzi_value_site_uv">0</em>
        </span>
        <span class="site-page-pv">
          <Icon name="page-visitors" />本页访客
          <em id="busuanzi_value_page_pv">0</em>
        </span>
      </div>
    </div>
  </div>
</footer>
<script
  is:inline
  th:if="${theme.config.footer.busuanzi}"
  async
  src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"
></script>
