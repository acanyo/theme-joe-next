---
/**
 * 右下角悬浮操作按钮：一条小竖条，从上到下是随机友链 / 目录 / 编辑 / 明暗切换 / 返回顶部。
 * 不同页面通过 props 声明需要的按钮；返回顶部滚动后才出现。
 */
import Icon from "../common/Icon.astro";
import { COLOR_MODE } from "../../config/expressions";
interface Props {
  /** 文章/页面的编辑入口：内容类型 */
  editKind?: "post" | "page";
  /** 是否显示移动端目录按钮 */
  toc?: boolean;
  /** 是否显示友链随机跳转按钮 */
  randomLink?: boolean;
}

const { editKind, toc = false, randomLink = false } = Astro.props;

const editHref =
  editKind === "post"
    ? "@{/console/posts/editor(name=${post.metadata.name},returnToView=true)}"
    : "@{/console/single-pages/editor(name=${singlePage.metadata.name},returnToView=true)}";
const editOwner =
  editKind === "post" ? "post.spec.owner" : "singlePage.spec.owner";
---

<div class="joe_action">
  {randomLink && (
    <button
      type="button"
      class="joe_action_item random"
      th:if="${theme.config.pages.links_random}"
      aria-label="随机访问友链"
    >
      <Icon name="shuffle" />
    </button>
  )}
  {toc && (
    <button
      type="button"
      class="joe_action_item toc"
      th:if="${theme.config.post.toc_mobile}"
      aria-label="文章目录"
    >
      <Icon name="toc" />
    </button>
  )}
  {editKind && (
    <div
      class="joe_action_item edit"
      th:if={`\${theme.config.post.edit_button and #authentication.name == ${editOwner}}`}
      sec:authorize="isAuthenticated()"
    >
      <a th:href={editHref} target="_blank" aria-label="编辑">
        <Icon name="edit" />
      </a>
    </div>
  )}
  <button
    type="button"
    class="joe_action_item mode"
    th:if={`\${(${COLOR_MODE}) == 'user'}`}
    aria-label="切换明暗模式"
  >
    <Icon name="sun" class="mode-light" />
    <Icon name="moon" class="mode-dark" />
  </button>
  <button
    type="button"
    class="joe_action_item back2top"
    th:if="${theme.config.effects.back_to_top}"
    aria-label="返回顶部"
  >
    <Icon name="arrow-up" />
  </button>
</div>
