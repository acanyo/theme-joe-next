---
/**
 * 文章 / 页面正文的公共部分：标题、作者信息、过期提示、广告、正文、点赞。
 * `subject` 为当前内容变量名：文章页为 "post"，独立页面为 "singlePage"。
 */
import { COMMENT_ENABLED, el } from "../../config/expressions";
import { POST_ICONS } from "../../data/post-icons";
import PostAds from "./PostAds.astro";

interface Props {
  subject: "post" | "singlePage";
}

const { subject: s } = Astro.props;
const isPost = s === "post";
const ann = (key: string, fallback: string) =>
  `#annotations.getOrDefault(${s}, '${key}', '${fallback}')`;
const ARTICLE_CLASS = [
  `#annotations.getOrDefault(${s}, 'img_align', theme.config.post.image_align ?: 'center') + '-img'`,
  `${ann("enable_copy", "true")} == 'false' or !theme.config.post.copyable ? 'uncopy' : ''`,
  "theme.config.post.indent ? 'indent' : ''",
  "theme.config.code.line_numbers and !theme.config.code.wrap ? 'line-numbers' : ''",
  "theme.config.code.inline_select ? 'single_code_select' : ''",
]
  .map((expr) => `\${${expr}}`)
  .join(" ");
---

<div
  class="joe_detail"
  th:attr={`data-cid=\${${s}.metadata.name}, data-kind=${isPost ? "Post" : "SinglePage"}, data-likes=\${${s}.stats.upvote}, data-toc-depth=\${#annotations.getOrDefault(${s}, 'toc_depth', '')}, data-fold-long-code=\${#annotations.getOrDefault(${s}, 'enable_fold_long_code', 'true')}`}
  th:with={`author = \${contributorFinder.getContributor(${s}.spec.owner)}`}
>
  {isPost && (
    <div
      class="joe_detail__category"
      th:unless="${#lists.isEmpty(post.categories)}"
    >
      <a
        th:each="category, stat : ${post.categories}"
        th:href="@{${category.status.permalink}}"
        class="item"
        th:classappend="${'item-' + (stat.index % 5)}"
        th:title="${category.spec.displayName}"
        th:text="${category.spec.displayName}"
      />
    </div>
  )}
  {isPost && (
    <span
      class="joe_raw"
      title="原始内容"
      th:if={`\${${ann("use_raw_content", "false")} == 'true'}`}
    ></span>
  )}
  <div class="joe_detail-wrapper">
    <h1
      class="joe_detail__title"
      th:classappend="${theme.config.post.title_shadow ? 'txt-shadow' : ''}"
      th:text={`\${${s}.spec.title}`}
    ></h1>

    <div
      class="joe_detail__count"
      th:if={`\${theme.config.post.meta and ${ann("enable_page_meta", "true")} == 'true'}`}
    >
      <div class="joe_detail__count-information">
        <img
          width="35"
          height="35"
          class="avatar"
          loading="lazy"
          th:src="${author?.avatar}"
          th:alt="${author?.displayName}"
          th:attr="data-text-avatar=${author?.displayName}"
          data-fallback="avatar"
        />
        <div class="meta">
          <div class="author">
            <a
              class="link"
              th:href="${#strings.isEmpty(theme.config.post.author_link) ? author?.permalink : theme.config.post.author_link}"
              th:text="${author?.displayName}"
            ></a>
          </div>
          <div class="item">
            <time
              class="text"
              th:text={`\${#dates.format(${s}.spec.publishTime, 'yyyy-MM-dd')}`}
            ></time>
            <span class="line">/</span>
            <span
              class="text"
              th:if={el(COMMENT_ENABLED)}
              th:text={`|\${${s}.stats.comment} 评论|`}
            ></span>
            <span class="line">/</span>
            <span class="text" th:text={`|\${${s}.stats.upvote} 点赞|`}></span>
            <span class="line">/</span>
            <span class="text" th:text={`|\${${s}.stats.visit} 阅读|`}></span>
            <span class="line">/</span>
            <span class="text" data-joe-word-count>
              0 字
            </span>
          </div>
        </div>
      </div>
      <time
        class="joe_detail__count-created"
        th:text={`\${#dates.format(${s}.status.lastModifyTime, 'MM/dd')}`}
      ></time>
    </div>

    <div
      class="joe_detail__overdue"
      th:if={`\${theme.config.post.outdated_notice and ${ann("enable_passage_tips", "true")} == 'true'}`}
      th:with={`staleDays = \${(#dates.createNow().getTime() - ${s}.status.lastModifyTime.toEpochMilli()) / 86400000}`}
    >
      <div class="joe_detail__overdue-wrapper">
        <div class="title">
          <Fragment set:html={POST_ICONS.tip} />
          <span class="text">温馨提示：</span>
        </div>
        <div class="content">
          <th-block th:if="${staleDays >= #conversions.convert(theme.config.post.outdated_days ?: 30, 'java.lang.Integer')}">
            <th-block
              th:if="${theme.config.post.outdated_format}"
              th:text={`|本文最后更新于 \${#dates.format(${s}.status.lastModifyTime, 'yyyy-MM-dd')}，若内容或图片失效，请留言反馈。|`}
            ></th-block>
            <th-block
              th:unless="${theme.config.post.outdated_format}"
              th:text="|本文最后更新于 ${staleDays} 天前，若内容或图片失效，请留言反馈。|"
            ></th-block>
          </th-block>
          <span th:text="${theme.config.post.outdated_text ?: '部分素材来自网络，若不小心影响到您的利益，请联系我们删除。'}"></span>
        </div>
      </div>
    </div>

    {isPost && <PostAds position="top" />}

    <article
      class={`joe_detail__article animated fadeIn`}
      th:classappend={`|${ARTICLE_CLASS}|`}
      th:style={`|--img-max-width: \${#annotations.getOrDefault(${s}, 'img_max_width', theme.config.post.image_max_width ?: '100%')}|`}
    >
      <div
        id="post-inner"
        th:if={`\${${ann("use_raw_content", "false")} != 'true'}`}
        th:utext={`\${${s}.content.content}`}
      ></div>
      <div
        id="post-inner"
        th:if={`\${${ann("use_raw_content", "false")} == 'true'}`}
        class="joe_raw_content"
        th:text={`\${${s}.content.content}`}
      ></div>
    </article>

    {isPost && (
      <div
        class="joe_detail__agree"
        th:if="${theme.config.post.like and #annotations.getOrDefault(post, 'enable_like', 'true') == 'true'}"
      >
        <button type="button" class="agree" data-joe-like aria-label="点赞">
          <span class="icon">
            <i class="joe-font joe-icon-like icon-like" aria-hidden="true" />
            <i
              class="joe-font joe-icon-like-fill icon-unlike"
              aria-hidden="true"
            />
          </span>
          <span class="nums" th:text="${post.stats.upvote}">
            0
          </span>
        </button>
      </div>
    )}
  </div>
</div>
