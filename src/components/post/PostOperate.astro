---
/** 文章标签、分享、打赏（正文下方） */
import DonateList from "./DonateList.astro";
import ShareLinks from "./ShareLinks.astro";
import {
  POST_URL,
  SHARE_ENABLED,
  DONATE_ENABLED,
  el,
} from "../../config/expressions";
---

<div class="joe_detail__operate" th:with={`postUrl = ${el(POST_URL)}`}>
  <div class="joe_detail__operate-tags">
    <a
      th:each="tag : ${post.tags}"
      th:href="@{${tag.status.permalink}}"
      th:text="${tag.spec.displayName}"
    ></a>
  </div>

  <div class="joe_detail__operate-share" th:if={el(SHARE_ENABLED)}>
    <i class="joe-font joe-icon-share" aria-hidden="true"></i>
    <ShareLinks />
  </div>

  <div class="joe_donate" th:if={el(DONATE_ENABLED)}>
    <i class="joe-font joe-icon-shang" aria-hidden="true"></i>
    <DonateList />
  </div>
</div>
