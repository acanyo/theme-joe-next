---
/**
 * 文章分享：复制链接、生成分享海报（scripts/content/poster.ts）。
 * 正文末尾操作栏与左侧悬浮栏共用；需在外层定义 `postUrl` 变量。
 * 海报需要的标题、摘要、封面、作者等写在 data-* 上，脚本只读这些，不依赖页面结构。
 */
import Icon from "../common/Icon.astro";
import { coverOf } from "../../config/expressions";

const COVER = coverOf("post");
---

<div class="share-icon-list">
  <a
    th:if="${theme.config.share.link}"
    class="share-action"
    href="javascript:;"
    title="复制文章链接"
    aria-label="复制文章链接"
    data-joe-share-link
    th:attr="data-url=${postUrl}, data-title=${post.spec.title}, data-description=${post.status.excerpt}, data-author=${post.owner.displayName}, data-template=${theme.config.share.link_template}"
  >
    <Icon name="link" />
  </a>
  <a
    th:if="${theme.config.share.poster}"
    class="share-action"
    href="javascript:;"
    title="生成分享海报"
    aria-label="生成分享海报"
    data-joe-share-poster
    th:attr={`data-url=\${postUrl}, data-title=\${post.spec.title}, data-excerpt=\${post.status.excerpt}, data-cover=\${${COVER}}, data-author=\${post.owner.displayName}, data-avatar=\${post.owner.avatar}, data-date=\${#dates.format(post.spec.publishTime, 'yyyy-MM-dd')}, data-site=\${site.title}, data-category=\${#lists.isEmpty(post.categories) ? '' : post.categories[0].spec.displayName}`}
  >
    <Icon name="image" />
  </a>
</div>
