---
/**
 * 文章系列：文章元数据 series 指定一个标签，文末列出该标签下的全部文章（按发布时间从早到晚），
 * 标出当前篇与进度（第 n / 共 m 篇），并给出系列内的上一篇 / 下一篇。
 * 超过 5 篇时只展示当前篇前后各 2 篇，其余折叠，可展开全部。
 */
import Icon from "../common/Icon.astro";

/** 系列最多读取的文章数 */
const MAX = 50;
const SERIES = "#annotations.getOrDefault(post, 'series', '')";
---

<!-- th:if 先于 th:with 求值，条件里直接读元数据 -->
<section
  class="joe_series"
  th:if={`\${not #strings.isEmpty(${SERIES})}`}
  th:with={`seriesTag = \${${SERIES}}`}
  aria-label="文章系列"
>
  <th-block
    th:with={`seriesTagVo = \${tagFinder.getByName(seriesTag)}, seriesPosts = \${postFinder.list({page: 1, size: ${MAX}, tagName: seriesTag, sort: {'spec.publishTime,asc'}}).items}`}
  >
    <th-block
      th:if="${seriesTagVo != null and #lists.size(seriesPosts) > 1}"
      th:with="current = ${seriesPosts.![metadata.name].indexOf(post.metadata.name)}, total = ${#lists.size(seriesPosts)}"
    >
      <header class="joe_series__head">
        <Icon name="toc" />
        <span class="joe_series__label">系列</span>
        <a
          class="joe_series__name"
          th:href="@{${seriesTagVo.status.permalink}}"
          th:text="${seriesTagVo.spec.displayName}"
        ></a>
        <span
          class="joe_series__progress"
          th:if="${current >= 0}"
          th:text="|第 ${current + 1} / ${total} 篇|"
        ></span>
      </header>

      <ol class="joe_series__list" th:style="|--series-total: ${total}|">
        <li
          th:each="item, iter : ${seriesPosts}"
          th:classappend="|${iter.index == current ? 'is-current' : ''} ${(current >= 0 and total > 5 and (iter.index < current - 2 or iter.index > current + 2)) ? 'is-far' : ''}|"
        >
          <span class="joe_series__index" th:text="${iter.count}"></span>
          <span
            class="joe_series__title"
            th:if="${iter.index == current}"
            th:text="${item.spec.title}"
            aria-current="page"
          ></span>
          <a
            class="joe_series__title"
            th:unless="${iter.index == current}"
            th:href="@{${item.status.permalink}}"
            th:text="${item.spec.title}"
          ></a>
        </li>
      </ol>
      <button
        type="button"
        class="joe_series__more"
        th:if="${current >= 0 and total > 5}"
        data-joe-series-more
      >
        展开全部 <span th:text="${total}"></span> 篇
      </button>

      <nav class="joe_series__nav" th:if="${current >= 0}" aria-label="系列内导航">
        <a
          class="prev"
          th:if="${current > 0}"
          th:href="@{${seriesPosts[current - 1].status.permalink}}"
        >
          <Icon name="chevron-left" />
          <span th:text="${seriesPosts[current - 1].spec.title}"></span>
        </a>
        <a
          class="next"
          th:if="${current < total - 1}"
          th:href="@{${seriesPosts[current + 1].status.permalink}}"
        >
          <span th:text="${seriesPosts[current + 1].spec.title}"></span>
          <Icon name="chevron-right" />
        </a>
      </nav>
    </th-block>
  </th-block>
</section>
