---
/**
 * 正文下方的相关文章（设置 post.related_cards）：同分类（没有分类时同标签）的文章（外层查好的 relatedList），
 * 不足 4 篇时用最新文章补足（去掉重复的和当前这篇）。带封面的卡片，横向排列，窄屏可横向滑动。
 * 侧栏的相关文章列表在手机上看不到，这里补上。
 */
import { coverOf } from "../../config/expressions";
import RelatedCard from "./RelatedCard.astro";

/** 补位用的最新文章：排除当前这篇和已经在相关文章里的 */
const FILLER = "postFinder.list({page: 1, size: 8}).items.?[metadata.name != #vars.post.metadata.name and !#vars.relatedNames.contains(metadata.name)]";
const MAX = 4;
const COVER = coverOf("item");
---

<section
  class="joe_related"
  aria-label="相关文章"
  th:if="${theme.config.post.related_cards}"
  th:with="relatedPosts = ${relatedList}"
>
  <!-- th:if / th:unless 先于同一元素上的 th:with 求值，判断要放在里层 -->
  <th-block th:with={`relatedNames = \${relatedPosts.![metadata.name]}, fillerPosts = \${relatedPosts.size() >= ${MAX} ? {} : ${FILLER}}`}>
  <th-block th:unless="${#lists.isEmpty(relatedPosts) and #lists.isEmpty(fillerPosts)}">
    <h2 class="joe_related__title">相关文章</h2>
    <ul class="joe_related__list">
      <li th:each="item, iter : ${relatedPosts}" th:if={`\${iter.index < ${MAX}}`} th:with={`cover = \${${COVER}}`}>
        <RelatedCard />
      </li>
      <!-- 同分类不足时用最新文章补足 -->
      <li
        th:each="item, iter : ${fillerPosts}"
        th:if={`\${iter.index < ${MAX} - relatedPosts.size()}`}
        th:with={`cover = \${${COVER}}`}
      >
        <RelatedCard />
      </li>
    </ul>
  </th-block>
  </th-block>
</section>
