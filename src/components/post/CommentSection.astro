---
/**
 * 评论区：使用 Halo 评论扩展点（halo:comment），评论系统由已安装的评论插件提供。
 * `subject` 为当前内容变量名；`kind` 为评论主体类型。
 */
import { POST_ICONS } from "../../data/post-icons";
import { COMMENT_ENABLED, el } from "../../config/expressions";

interface Props {
  subject: string;
  kind: "Post" | "SinglePage";
  group?: string;
}

const { subject, kind, group = "content.halo.run" } = Astro.props;
const enabledGlobally =
  "!theme.config.footer.clean_mode and theme.config.post.comments";
---

<div class="joe_comment" th:if={el(COMMENT_ENABLED)}>
  <div
    class="joe_comment__close"
    th:unless={`\${${enabledGlobally}}`}
  >
    <Fragment set:html={POST_ICONS.commentClosed} />
    <span
      th:text={`\${${enabledGlobally} ? '博主关闭了当前页面的评论' : '博主关闭了所有页面的评论'}`}
    ></span>
  </div>
  <div
    class="joe_comment_box"
    th:if={`\${${enabledGlobally}}`}
  >
    <div class="box_title">
      <h2>评论区</h2>
    </div>

    <!-- 认出访客：留过言的访客 / 登录用户在评论框上方看到问候（features/comment-greeting.ts） -->
    <p class="joe_comment__hello" data-joe-comment-hello hidden></p>
    <th-block sec:authorize="isAuthenticated()">
      <span
        hidden
        data-joe-comment-user
        th:with="me = ${contributorFinder.getContributor(#authentication.name)}"
        th:attr="data-name=${me?.displayName}"
      ></span>
    </th-block>

    <div th:if={el(COMMENT_ENABLED)}>
      <halo-comment
        group={group}
        kind={kind}
        th:attr={`name=\${${subject}.metadata.name}`}
      ></halo-comment>
    </div>
  </div>
</div>
