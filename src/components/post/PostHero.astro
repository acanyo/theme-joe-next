---
/**
 * 沉浸头图：左侧标题与写作记录，底部集中呈现作者和阅读信息。
 * 经典样式的标题与信息仍由 ArticleBody.astro 渲染。
 */
import { COMMENT_ENABLED, el } from "../../config/expressions";
import Icon from "../common/Icon.astro";
import PostContext from "./PostContext.astro";

const COVER = "post.spec.cover";
const AUTHOR_LINK =
  "#strings.isEmpty(theme.config.post.author_link) ? author?.permalink : theme.config.post.author_link";
---

<header
  class="joe_post_hero"
  th:if="${(theme.config.post.header_style ?: 'immersive') == 'immersive'}"
  th:classappend={`\${#strings.isEmpty(${COVER}) ? 'is-plain' : 'has-cover'}`}
  th:with="author = ${post.owner}"
>
  <div
    class="joe_post_hero__bg"
    th:if={`\${not #strings.isEmpty(${COVER})}`}
    th:style={`|background-image: url('\${thumbnail.gen(${COVER}, 'l')}')|`}
    aria-hidden="true"
  ></div>
  <div class="joe_post_hero__inner joe_container">
    <div class="joe_post_hero__body">
      <div
        class="joe_post_hero__cats"
        th:unless="${#lists.isEmpty(post.categories)}"
      >
        <a
          th:each="category : ${post.categories}"
          th:href="@{${category.status.permalink}}"
          class="item"
          th:text="${category.spec.displayName}"
        ></a>
      </div>
      <h1
        class="joe_post_hero__title"
        th:classappend="${theme.config.post.title_shadow ? 'txt-shadow' : ''}"
        th:text="${post.spec.title}"
      ></h1>
      <p
        class="joe_post_hero__excerpt"
        th:if="${not #strings.isEmpty(post.status.excerpt)}"
        th:text="${post.status.excerpt}"
        th:attr="data-joe-excerpt=${post.spec.excerpt?.autoGenerate != false ? 'auto' : null}"
      ></p>
      <PostContext variant="hero" />
    </div>
    <div class="joe_post_hero__footer" th:if="${theme.config.post.meta}">
      <div class="joe_post_hero__byline">
        <img
          width="36"
          height="36"
          loading="lazy"
          th:src="${#strings.isEmpty(author?.avatar) ? (theme.config.blogger.fallback_avatar ?: #theme.assets('/images/peeps-avatar.png')) : author.avatar}"
          sizes="36px"
          th:alt="${author?.displayName}"
          th:attr="data-text-avatar=${author?.displayName}"
          data-fallback="avatar"
        />
        <div class="joe_post_hero__author">
          <a rel="author" th:href={el(AUTHOR_LINK)} th:text="${author?.displayName}"></a>
          <time
            th:datetime="${post.spec.publishTime}"
            th:text="|发布于 ${#dates.format(post.spec.publishTime, 'yyyy年MM月dd日')}|"
            th:title="${#dates.format(post.spec.publishTime, 'yyyy-MM-dd HH:mm')}"
          ></time>
        </div>
      </div>
      <ul class="joe_post_hero__meta" aria-label="文章信息">
        <li>
          <Icon name="views" />
          <span th:text="|${post.stats.visit} 次阅读|"></span>
        </li>
        <li>
          <Icon name="hourglass" />
          <span data-joe-word-count="compact">阅读时长</span>
        </li>
        <li th:if={el(COMMENT_ENABLED)}>
          <Icon name="comment" />
          <span th:text="${post.stats.comment == 0 ? '暂无评论' : post.stats.comment + ' 条评论'}"></span>
        </li>
        <li class="joe_post_hero__share">
          <button type="button" data-joe-share-link title="复制文章链接" aria-label="复制文章链接">
            <Icon name="share" />
          </button>
        </li>
      </ul>
    </div>
  </div>
</header>
