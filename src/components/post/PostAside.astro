---
/** 文章页侧栏：博主卡片、目录、相关文章、侧栏广告 */
import BloggerCard from "../blogger/BloggerCard.astro";
import AsideCard from "../aside/AsideCard.astro";
import PostAds from "./PostAds.astro";
import Icon from "../common/Icon.astro";

/** 侧栏最多列几篇（relatedList 由 pages/post.astro 查好，比这个多一篇） */
const RELATED_SIZE = "#conversions.convert(theme.config.post.related_count ?: 5, 'java.lang.Integer')";
---

<aside class="joe_aside">
  <th-block th:if="${theme.config.blogger.enabled}">
    <BloggerCard />
  </th-block>
  <div class="joe_aside_post">
    <div
      class="toc-container"
      th:if="${theme.config.post.toc}"
    >
      <h3 class="toc-header">
        <Icon name="toc" />文章目录
      </h3>
      <nav id="js-toc" class="toc" aria-label="文章目录"></nav>
    </div>
    <th-block th:if="${theme.config.post.related and (not #lists.isEmpty(post.categories) or not #lists.isEmpty(post.tags))}">
      <AsideCard variant="newest" icon="hot" title="相关文章">
        <div class="joe_aside__item-contain">
          <ul class="list">
            <li
              class="item"
              th:each="item, iter : ${relatedList}"
              th:if={`\${iter.index < ${RELATED_SIZE}}`}
            >
              <a
                class="link"
                th:href="@{${item.status.permalink}}"
                th:title="${item.spec.title}"
                th:text="${item.spec.title}"
              ></a>
              <Icon name="link" />
            </li>
          </ul>
        </div>
      </AsideCard>
    </th-block>
    <PostAds position="aside" />
  </div>
</aside>
