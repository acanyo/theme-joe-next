---
/**
 * 音乐播放器（设置 navbar.music）：导航右侧一个音符按钮，点开是一小块播放面板。
 *
 *   ┌ 封面 · 歌名 / 歌手 · 播放暂停 ┐
 *   │ 进度条（可拖动）  当前 / 总时长 │
 *   │ 一行当前歌词（有歌词时）       │
 *   │ 上一首 · 播放顺序 · 下一首 · 音量 │
 *   └ 歌单列表（点一首开始播放）     ┘
 *
 * 导航在 swup 容器（#swup）之外，开启无刷新切页时 <audio> 不会被替换，换页不中断。
 * 歌单数据：「自己填写」时由服务端输出到 window.__JOE_MUSIC__；「网易云歌单」时由脚本请求 Meting 接口（features/music.ts）。
 * 播放中按钮上的音符跳动，表示有声音。
 */
import Icon from "../common/Icon.astro";

/**
 * 「自己填写」的歌单：用 Thymeleaf 的 JavaScript 内联输出（和 ConfigScript 的主题配置一样），
 * 歌名、地址里的引号与 </script> 都会被转义。网易云歌单时不输出。
 */
const LIST_SCRIPT = `window.__JOE_MUSIC__ = /*[[\${theme.config.navbar.music_source == 'meting' ? null : theme.config.navbar.music_list}]]*/ null;`;
---

<th-block th:if="${theme.config.navbar.music}">
  <script is:inline th:inline="javascript" set:html={LIST_SCRIPT} />
  <button
    type="button"
    class="joe_header__music"
    aria-label="音乐播放器"
    aria-haspopup="dialog"
    aria-expanded="false"
    data-joe-music-toggle
  >
    <Icon name="music" />
    <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
  </button>

  <div
    class="joe_music"
    role="dialog"
    aria-label="音乐播放器"
    hidden
    data-joe-music
    th:attr="data-source=${theme.config.navbar.music_source ?: 'list'}, data-playlist=${theme.config.navbar.music_playlist}, data-api=${theme.config.navbar.music_api ?: 'https://api.injahow.cn/meting/'}, data-volume=${theme.config.navbar.music_volume ?: 60}"
  >
    <div class="joe_music__sheet">
      <div class="now">
        <span class="cover"><img alt="" hidden data-music-cover /><Icon name="music" /></span>
        <div class="meta">
          <p class="title" data-music-title>还没有选歌</p>
          <p class="artist" data-music-artist></p>
        </div>
        <button type="button" class="play" data-music-play aria-label="播放">
          <Icon name="play" class="i-play" />
          <Icon name="pause" class="i-pause" />
        </button>
      </div>

      <div class="progress">
        <input
          type="range"
          min="0"
          max="1000"
          value="0"
          step="1"
          aria-label="播放进度"
          data-music-seek
        />
        <span class="time"><span data-music-current>0:00</span> / <span data-music-duration>0:00</span></span>
      </div>

      <p class="lyric" data-music-lyric aria-live="off"></p>

      <div class="controls">
        <button type="button" data-music-prev aria-label="上一首"><Icon name="skip-back" /></button>
        <button type="button" data-music-mode aria-label="播放顺序：列表循环" title="列表循环">
          <Icon name="repeat" class="m-list" />
          <Icon name="repeat-1" class="m-one" />
          <Icon name="shuffle" class="m-random" />
        </button>
        <button type="button" data-music-next aria-label="下一首"><Icon name="skip-forward" /></button>
        <label class="volume">
          <Icon name="volume" />
          <input type="range" min="0" max="100" step="1" aria-label="音量" data-music-volume />
        </label>
      </div>

      <ol class="list" data-music-items aria-label="歌单"></ol>
      <p class="empty" data-music-empty hidden></p>
    </div>
    <audio preload="none" data-music-audio></audio>
  </div>
</th-block>
