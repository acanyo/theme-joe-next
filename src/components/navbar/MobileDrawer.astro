---
/**
 * 移动端侧滑抽屉：博主信息、站点统计、栏目菜单。
 * 依赖 Navbar 中定义的 `navMenu` 变量。
 */
import SocialLinks from "../blogger/SocialLinks.astro";
import Icon from "../common/Icon.astro";
import { BLOGGER_NAME, COMMENT_ENABLED, el } from "../../config/expressions";
---

<div class="joe_header__slideout">
  <div class="joe_header__slideout-wrap">
    <img
      width="100%"
      height="150"
      class="joe_header__slideout-image"
      th:src="${theme.config.blogger.cover ?: #theme.assets('/images/author_bg.jpg')}"
      alt=""
      data-fallback="image"
    />
    <div class="joe_header__slideout-author">
      <img
        width="50"
        height="50"
        class="avatar"
        loading="lazy"
        th:src="${theme.config.blogger.avatar ?: theme.config.blogger.fallback_avatar}"
        alt="博主头像"
        th:attr={`data-text-avatar=${el(BLOGGER_NAME)}`}
        data-fallback="avatar"
      />
      <div class="info">
        <a class="link" th:href="${site.url}">
          <span th:text={el(BLOGGER_NAME)}></span>
          <img
            th:if="${theme.config.blogger.level}"
            class="level"
            th:src="@{/assets/images/level_1.svg}"
            alt="博主等级"
          />
        </a>
        <p class="motto joe_motto" th:text="${theme.config.blogger.motto}"></p>
      </div>
    </div>

    <th-block th:if="${theme.config.blogger.social_mobile}">
      <SocialLinks />
    </th-block>

    <ul
      class="joe_header__slideout-count"
      th:with="stats = ${siteStatsFinder.getStats()}"
    >
      <li class="item">
        <Icon name="archive" />
        <span>
          累计撰写 <strong th:text="${stats.post}">0</strong> 篇文章
        </span>
      </li>
      <li class="item">
        <Icon name="hot" />
        <span>
          累计创建{" "}
          <strong th:text="${#lists.size(tagFinder.listAll())}">0</strong>{" "}
          个标签
        </span>
      </li>
      <li class="item" th:if={el(COMMENT_ENABLED)}>
        <Icon name="comment" />
        <span>
          累计收到 <strong th:text="${stats.comment}">0</strong> 条评论
        </span>
      </li>
    </ul>

    <ul class="joe_header__slideout-menu panel-box">
      <li>
        <a class="link panel in" href="#" rel="nofollow">
          <span>栏目</span>
          <Icon name="chevron-right" />
        </a>
        <ul
          class="slides panel-body panel-box panel-side-menu"
          style="display: block"
        >
          <li
            th:if="${navMenu != null}"
            th:each="menuItem : ${navMenu.menuItems}"
          >
            <a
              th:if="${#lists.isEmpty(menuItem.children)}"
              class="link"
              th:href="@{${menuItem.status.href}}"
              th:target="${menuItem.spec.target?.value}"
              th:text="${menuItem.status.displayName}"
            ></a>
            <th-block th:unless="${#lists.isEmpty(menuItem.children)}">
              <div class="link panel">
                <a
                  th:href="@{${menuItem.status.href}}"
                  th:target="${menuItem.spec.target?.value}"
                  th:text="${menuItem.status.displayName}"
                ></a>
                <Icon name="chevron-right" />
              </div>
              <ul class="slides panel-body">
                <li th:each="childMenu : ${menuItem.children}">
                  <a
                    th:if="${#lists.isEmpty(childMenu.children)}"
                    class="link"
                    th:href="@{${childMenu.status.href}}"
                    th:target="${childMenu.spec.target?.value}"
                    th:text="${childMenu.status.displayName}"
                  ></a>
                  <th-block th:unless="${#lists.isEmpty(childMenu.children)}">
                    <div class="link panel">
                      <a
                        th:href="@{${childMenu.status.href}}"
                        th:target="${childMenu.spec.target?.value}"
                        th:text="${childMenu.status.displayName}"
                      ></a>
                      <Icon name="chevron-right" />
                    </div>
                    <ul class="slides panel-body">
                      <li th:each="subMenu : ${childMenu.children}">
                        <a
                          class="link"
                          th:href="@{${subMenu.status.href}}"
                          th:target="${subMenu.spec.target?.value}"
                          th:text="${subMenu.status.displayName}"
                        ></a>
                      </li>
                    </ul>
                  </th-block>
                </li>
              </ul>
            </th-block>
          </li>
        </ul>
      </li>
    </ul>
  </div>
</div>
