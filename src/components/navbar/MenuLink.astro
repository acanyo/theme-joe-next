---
import Icon from "../common/Icon.astro";
/**
 * 单个导航链接。`item` 为当前作用域中菜单项变量名（构建期常量），
 * 例如 "menuItem"、"childMenu"。其余属性（如 th:if）原样透传到 <a>。
 */
interface Props {
  item: string;
  /** 是否显示菜单图标（桌面导航显示，侧栏不显示） */
  withIcon?: boolean;
  class?: string;
  [attr: string]: unknown;
}

const {
  item,
  withIcon = false,
  class: className = "item",
  ...rest
} = Astro.props;
---

<a
  class={className}
  th:href={`@{\${${item}.status.href}}`}
  th:target={`\${${item}.spec.target?.value}`}
  th:title={`\${${item}.status.displayName}`}
  {...rest}
>
  {withIcon && (
    <th-block th:if="${theme.config.navbar.icons}">
      <!-- 菜单项元数据 icon 为 Iconify 选择器保存的 SVG；未设置（或旧版的图标字体类名）时显示默认图标 -->
      <i
        class="m-icon joe-font"
        aria-hidden="true"
        th:if={`\${#strings.startsWith(#annotations.getOrDefault(${item}, 'icon', ''), '<svg')}`}
        th:utext={`\${#annotations.get(${item}, 'icon')}`}
      ></i>
      <th-block
        th:unless={`\${#strings.startsWith(#annotations.getOrDefault(${item}, 'icon', ''), '<svg')}`}
      >
        <Icon name="menu-item" class="m-icon" />
      </th-block>
    </th-block>
  )}
  <span th:text={`\${${item}.status.displayName}`}></span>
</a>
