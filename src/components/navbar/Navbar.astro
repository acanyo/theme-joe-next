---
/**
 * 顶部导航。菜单来源：设置中选择的菜单，未选择时使用 Halo 主菜单。
 * 桌面端最多渲染三级菜单，移动端侧栏同样三级。
 *
 * 样式由设置 navbar.style 决定：
 * - islands（默认）：Logo / 菜单 / 工具按钮三块玻璃胶囊，页面顶部透明，滚动后浮起（styles/layout/islands.css）
 * - classic：Joe 原来的通栏
 * 文章页滚动后，浮岛样式中间一块显示文章标题：标题来自 #swup 的 data-joe-title，
 * 由 navigation.ts 在每次进入页面时写入（无刷新切页时导航不会被替换）。
 */
import MenuLink from "./MenuLink.astro";
import MobileDrawer from "./MobileDrawer.astro";

const MENU =
  "#strings.isEmpty(theme.config.navbar.menu) ? menuFinder.getPrimary() : menuFinder.getByName(theme.config.navbar.menu)";
---

<header
  class="joe_header"
  th:classappend="${(theme.config.navbar.style ?: 'islands') == 'islands' ? 'joe_header--islands' : ''}"
  th:with={`navMenu = \${${MENU}}`}
>
  <div
    class="joe_header__above"
    th:classappend="|${theme.config.effects.reveal ? 'topInDown' : ''} ${theme.config.navbar.sticky ? 'fixed' : ''} ${theme.config.navbar.sticky and theme.config.navbar.glass ? 'glass' : ''}|"
  >
    <div
      class="joe_container joe_header_container"
      th:classappend="${theme.config.navbar.full_width ? 'full' : ''}"
    >
      <button
        type="button"
        class="joe_header__above-slideicon"
        aria-label="打开菜单"
      >
        <i class="joe-font joe-icon-caidan" aria-hidden="true"></i>
      </button>

      <a
        th:if="${theme.config.navbar.logo}"
        class="joe_header__above-logo"
        th:title="${site.title}"
        th:href="${#strings.isEmpty(theme.config.navbar.logo_link) ? site.url : (theme.config.navbar.logo_link == '#' ? 'javascript:;' : theme.config.navbar.logo_link)}"
      >
        <img
          th:src="${site.logo}"
          th:alt="${site.title}"
          th:style="|border-radius: ${theme.config.navbar.logo_radius ?: '4px'}|"
          data-fallback="avatar"
        />
      </a>
      <a
        th:unless="${theme.config.navbar.logo}"
        class="joe_header__above-logo joe_header__above-logo--text"
        th:href="${site.url}"
        th:title="${site.title}"
        th:text="${site.title}"
      ></a>

      <nav
        class="joe_header__above-nav"
        aria-label="主导航"
        th:classappend="|${theme.config.navbar.active_glow ? 'active-shadow' : ''} ${theme.config.navbar.icon_animation ? 'active-animate' : ''}|"
      >
        <th-block
          th:if="${navMenu != null}"
          th:each="menuItem : ${navMenu.menuItems}"
        >
          <MenuLink
            item="menuItem"
            withIcon
            th:if="${#lists.isEmpty(menuItem.children)}"
          />
          <div
            class="joe_dropdown"
            data-trigger="hover"
            th:unless="${#lists.isEmpty(menuItem.children)}"
          >
            <div class="joe_dropdown__link">
              <MenuLink item="menuItem" withIcon />
              <i
                class="joe-font joe-icon-arrow-down joe_dropdown__link-icon"
                aria-hidden="true"
              ></i>
            </div>
            <ul class="joe_dropdown__menu">
              <li
                th:each="childMenu : ${menuItem.children}"
                th:classappend="${#lists.isEmpty(childMenu.children)} ? '' : 'joe_nav_sub-li'"
              >
                <MenuLink item="childMenu" withIcon />
                <ol
                  class="joe_nav_sub"
                  th:unless="${#lists.isEmpty(childMenu.children)}"
                >
                  <li th:each="subMenu : ${childMenu.children}">
                    <MenuLink item="subMenu" withIcon />
                  </li>
                </ol>
              </li>
            </ul>
          </div>
        </th-block>
        <button
          type="button"
          class="joe_header__page-title"
          title="回到顶部"
          th:attr="data-site-title=${site.title}"
          th:text="${site.title}"
        ></button>
      </nav>

      <div class="joe_header__above-search">
        <!-- 浮岛样式：阅读进度圆环，离开顶部后出现，点击回到顶部（features/navigation.ts） -->
        <button
          type="button"
          class="joe_header__progress"
          aria-label="回到顶部"
          title="回到顶部"
        >
          <svg viewBox="0 0 36 36" aria-hidden="true">
            <circle class="track" cx="18" cy="18" r="15"></circle>
            <circle class="bar" cx="18" cy="18" r="15" pathLength="100"></circle>
          </svg>
          <span class="value">0</span>
          <svg class="up" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 19V5M5 12l7-7 7 7"></path>
          </svg>
        </button>
        <button
          type="button"
          class="submit"
          aria-label="搜索"
          data-joe-search
          th:if="${pluginFinder.available('PluginSearchWidget')}"
        >
          <i class="joe-font joe-icon-search" aria-hidden="true"></i>
        </button>
        <div class="nav_login" th:if="${theme.config.navbar.login}">
          <a
            class="login_before"
            sec:authorize="isAnonymous()"
            th:href="@{/login}"
            title="登录"
          >
            <i class="jiewen joe-icon-zhanghao" aria-hidden="true"></i>
          </a>
          <a
            class="login_after"
            sec:authorize="isAuthenticated()"
            th:href="@{/uc}"
            th:with="me = ${contributorFinder.getContributor(#authentication.name)}"
            th:title="${me?.displayName}"
          >
            <img
              th:src="${me?.avatar}"
              th:alt="${me?.displayName}"
              th:attr="data-text-avatar=${me?.displayName}"
              data-fallback="avatar"
            />
          </a>
        </div>
      </div>

      <button
        type="button"
        class="joe_header__above-searchicon"
        aria-label="搜索"
        data-joe-search
        th:if="${pluginFinder.available('PluginSearchWidget')}"
      >
        <i class="joe-font joe-icon-search" aria-hidden="true"></i>
      </button>
    </div>
  </div>

  <MobileDrawer />

  <div class="joe_header__toc" aria-label="文章目录">
    <div class="joe_header__toc-wrap">
      <div class="toc_top">
        <h3>目录</h3>
        <img
          width="100%"
          height="150"
          th:src="${theme.config.blogger.cover ?: #theme.assets('/images/context_bg.png')}"
          alt=""
          data-fallback="image"
        />
      </div>
      <div id="js-toc-mobile" class="toc"></div>
    </div>
  </div>

  <div class="joe_header__mask"></div>
</header>
