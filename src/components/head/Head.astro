---
/**
 * 公共 <head>。SEO 描述、关键词由 Halo 注入，这里不重复输出。
 */
import ConfigScript from "./ConfigScript.astro";
import DynamicStyle from "./DynamicStyle.astro";
import "../../styles/index.css";

interface Props {
  /** 页面标题的 SpEL 表达式（不含 `${}`），为空时使用站点标题 */
  title?: string;
  /** 额外的输出条件（布局契约中 head 由调用方提供时不输出标题） */
  titleIf?: string;
}

const { title = "site.title", titleIf } = Astro.props;
---

<meta charset="utf-8" />
<meta
  name="viewport"
  content="width=device-width, initial-scale=1, viewport-fit=cover"
/>
<meta name="renderer" content="webkit" />
<meta name="format-detection" content="telephone=no,email=no" />
<title
  th:if={titleIf ? `\${${titleIf}}` : undefined}
  th:text={`\${${title}}`}
></title>
<!-- 网站图标：Halo「系统设置 → 基本设置」的站点图标，没有设置时用站点 Logo -->
<th-block th:with="siteIcon = ${not #strings.isEmpty(site.favicon) ? site.favicon : site.logo}">
  <link rel="icon" th:if="${not #strings.isEmpty(siteIcon)}" th:href="${siteIcon}" />
  <link rel="apple-touch-icon" th:if="${not #strings.isEmpty(siteIcon)}" th:href="${siteIcon}" />
</th-block>
<link
  rel="stylesheet"
  th:if="${theme.config.effects.cursor_skin != null and theme.config.effects.cursor_skin != 'off' and !theme.config.footer.clean_mode}"
  th:href="${#theme.assets('/cursor/' + theme.config.effects.cursor_skin + '/style.css')}"
/>
<ConfigScript />
<DynamicStyle />
<slot />
