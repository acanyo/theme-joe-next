---
/**
 * 依赖主题设置的 CSS 变量与样式（主题色、背景图、滚动条、内容宽度等）。
 * 使用 Thymeleaf 文本内联，在请求时生成；静态样式全部在 src/styles 中。
 * 开头声明级联层顺序：本样式先于主题样式表输出，层顺序以第一次声明为准（与 src/styles/index.css 相同）。
 * 本样式本身不分层，优先级高于主题样式。
 */
const css = `
@layer reset, tokens, vendor, base, components, layout, content, pages;
[# th:if="\${(theme.config.effects.page_transition ?: 'native') == 'native'}"]
@media (prefers-reduced-motion: no-preference) { @view-transition { navigation: auto; } }
[/]
html body {
  --theme: [(\${theme.config.appearance.accent_light ?: '#fb6c28'})];
  --wave-color: [(\${theme.config.home.hero_wave_light ?: '#fff'})];
  --scroll-bar: [(\${theme.config.appearance.scrollbar_color ?: '#c0c4cc'})];
  --loading-bar: [(\${theme.config.effects.loading_bar_color ?: 'var(--theme)'})];
  --loading-bar-height: [(\${#strings.replace(theme.config.effects.loading_bar_height ?: 3, 'px', '')})]px;
  --content-max-width: [(\${theme.config.appearance?.content_width ?: (theme.config.general?.content_width ?: 1320)})]px;
}
html[data-mode="dark"] body {
  --theme: [(\${theme.config.appearance.accent_dark ?: '#9999ff'})];
  --wave-color: [(\${theme.config.home.hero_wave_dark ?: '#fff'})];
  --scroll-bar: [(\${theme.config.appearance.scrollbar_color ?: '#666'})];
}
::-webkit-scrollbar { width: [(\${#strings.replace(theme.config.appearance.scrollbar_width ?: 8, 'px', '')})]px; }
[# th:if="\${not #strings.isEmpty(theme.config.appearance.background_light)}"]
html[data-mode="light"] body::before { background-image: url("[(\${theme.config.appearance.background_light})]"); }
[/]
[# th:if="\${not #strings.isEmpty(theme.config.appearance.background_dark)}"]
html[data-mode="dark"] body::before { background-image: url("[(\${theme.config.appearance.background_dark})]"); }
[/]
[# th:if="\${not #strings.isEmpty(theme.config.home.hero_image)}"]
html body { --joe-big-banner-image: url("[(\${theme.config.home.hero_image})]"); }
[/]
`;
---

<style is:inline th:inline="text" set:html={css} />
