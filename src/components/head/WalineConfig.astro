---
/** Waline 评论配置注入（仅在启用 Waline 时输出），由 scripts/content/waline.ts 读取 */
import { WALINE_ENABLED } from "../../config/expressions";

const W = "theme.config.basic.waline";
const code = `window.__JOE_WALINE__ = {
  serverURL: /*[[\${#strings.trim(${W}.waline_serverURL)}]]*/ "",
  options: /*[[\${${W}.waline_config_basic_json}]]*/ "",
  imageUploader: /*[[\${${W}.waline_config_imageUpload_option}]]*/ "default",
  lskypro: { apiURL: /*[[\${${W}.lskypro?.lskypro_apiURL}]]*/ "", token: /*[[\${${W}.lskypro?.lskypro_apiTOKEN}]]*/ "" },
};`;
---

<script
  is:inline
  th:if={`\${${WALINE_ENABLED}}`}
  th:inline="javascript"
  set:html={code}
/>
