---
/**
 * 博主社交账号列表。默认模式使用内置平台图标（th:switch 选择），
 * 自定义模式使用 Iconify 设置，兼容原有 SVG。
 */
import { SOCIAL_PLATFORMS } from "../../data/social-platforms";
import { iconSvg } from "../../config/icons";
import ConfiguredIcon from "../ConfiguredIcon.astro";

interface Props {
  enabled?: string;
  labels?: boolean;
}

const { enabled = "theme.config.blogger.social", labels = false } = Astro.props;
---

<div
  class="social-account"
  th:if={`\${(${enabled}) and ((theme.config.blogger.social_source != 'custom' and not #lists.isEmpty(theme.config.blogger.social_links)) or (theme.config.blogger.social_source == 'custom' and not #lists.isEmpty(theme.config.blogger.social_custom)))}`}
>
  <th-block
    th:if="${theme.config.blogger.social_source != 'custom'}"
    th:each="socials : ${theme.config.blogger.social_links}"
  >
    <th-block th:switch="${socials.platform}">
      {SOCIAL_PLATFORMS.map((platform) => (
        <a
          th:case={`'${platform.name}'`}
          class={platform.name}
          th:href={`\${${platform.href}}`}
          target="_blank"
          title={platform.title}
          aria-label={platform.title}
          rel="noopener noreferrer nofollow"
          style={`--brand: ${platform.color}`}
        >
          <Fragment set:html={iconSvg(platform.name)} />
          {labels && <span class="social-label">{platform.title}</span>}
        </a>
      ))}
    </th-block>
  </th-block>
  <th-block th:if="${theme.config.blogger.social_source == 'custom'}">
    <a
      th:each="social : ${theme.config.blogger.social_custom}"
      class="custom_socials"
      th:href="${social.url}"
      th:title="${social.name}"
      th:attr="aria-label=${social.name}"
      target="_blank"
      rel="noopener noreferrer nofollow"
    >
      <ConfiguredIcon value="social.icon" />
      {labels && <span class="social-label" th:text="${social.name}"></span>}
    </a>
  </th-block>
</div>
