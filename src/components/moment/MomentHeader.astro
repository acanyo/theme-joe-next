---
/** 瞬间页头部：标题 + 作者信息 */
import { BLOGGER_NAME, el } from "../../config/expressions";
import Icon from "../common/Icon.astro";

interface Props {
  /** 作者头像/名称来源：列表页显示博主，详情页显示瞬间作者 */
  author: "blogger" | "owner";
}

const { author } = Astro.props;
const NAME = author === "owner" ? "moment.owner.displayName" : BLOGGER_NAME;
const AVATAR =
  author === "owner" ? "moment.owner.avatar" : "theme.config.blogger.avatar";
const LINK =
  author === "owner"
    ? "@{/authors/{name}(name=${moment.owner.name})}"
    : "${site.url}";
---

<h1
  class="joe_detail__title txt-shadow"
  th:text="${theme.config.pages.moments_title ?: '我的动态'}"
></h1>
<a
  class="joe_journal_add"
  th:if="${theme.config.pages.moments_compose_button}"
  sec:authorize="isAuthenticated()"
  th:href="@{/console/moments}"
  target="_blank"
  rel="nofollow"
  aria-label="发布瞬间"
>
  <Icon name="edit" />
</a>
<div class="joe_detail__count">
  <div class="joe_detail__count-information">
    <img
      width="35"
      height="35"
      class="avatar"
      loading="lazy"
      th:src={el(AVATAR)}
      th:alt={el(NAME)}
      th:attr={`data-text-avatar=${el(NAME)}`}
      data-fallback="avatar"
    />
    <div class="meta">
      <div class="author">
        <a class="link" th:href={LINK} th:text={el(NAME)}></a>
      </div>
      <div class="item">
        <span
          class="text"
          th:text="${theme.config.blogger.motto ?: '行动起来，活在当下'}"
        ></span>
      </div>
    </div>
  </div>
</div>
