---
/**
 * 所有页面共用的外层布局：<head>、导航、主体、页脚、悬浮按钮、全局脚本。
 *
 * 页面通过 slot 提供内容：
 * - 默认 slot：主体内容（位于 .joe_container 内）
 * - "before"：容器之前的整宽内容，如首页大图、面包屑
 * - "head"：额外的 <head> 内容
 * - "actions"：自定义悬浮按钮（默认使用 <Actions />）
 *
 * 无刷新切页（swup）时只替换 #swup 内的内容；导航与页脚常驻，切页后由脚本同步状态。
 */
import Head from "../components/head/Head.astro";
import Navbar from "../components/navbar/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import Actions from "../components/layout/Actions.astro";
import BigBanner from "../components/home/BigBanner.astro";
import "../styles/pages/big-banner.css";
import type { PageScript } from "../scripts/core/page-scripts";

interface Props {
  /** 页面标题 SpEL 表达式（不含 `${}`） */
  title?: string;
  /** 主体容器附加类名，例如 "page-index"、"page-post" */
  pageClass: string;
  /** 是否渲染容器（错误页等全屏页面可关闭） */
  container?: boolean;
  /** 首屏大图：首页为全屏模式，列表页为普通模式，文章页等不显示 */
  bigBanner?: "fullscreen" | "normal" | false;
  /** 大图标题表达式（默认站点标题） */
  heading?: string;
  /** 页面脚本名，对应 src/scripts/core/page-scripts.ts 中的注册项 */
  pageScript?: PageScript;
}

const {
  title,
  pageClass,
  container = true,
  bigBanner = false,
  heading,
  pageScript,
} = Astro.props;
---

<!doctype html>
<html
  th:lang="${#locale.toLanguageTag}"
  th:attr="data-transition=${theme.config.effects.page_transition ?: 'native'}"
>
  <head>
    <Head title={title}>
      <slot name="head" />
    </Head>
  </head>
  <body>
    <div id="Joe">
      <Navbar />
      <div id="swup" class="joe_swup" data-joe-script={pageScript}>
        {bigBanner && (
          <th-block th:if="${theme.config.hero.enabled}">
            <BigBanner
              fullscreen={bigBanner === "fullscreen"}
              title={heading}
            />
          </th-block>
        )}
        <slot name="before" />
        {container ? (
          <div
            class:list={["joe_container joe_main_container", pageClass]}
            th:classappend="${theme.config.aside.position == 'left' ? 'revert' : ''}"
          >
            <slot />
          </div>
        ) : (
          <slot />
        )}
        {Astro.slots.has("actions") ? <slot name="actions" /> : <Actions />}
      </div>
      <Footer />
    </div>
    <halo-footer></halo-footer>
    <script>
      import "../scripts/app";
    </script>
  </body>
</html>
