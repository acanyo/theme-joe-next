---
import BaseLayout from "../layouts/BaseLayout.astro";
import Aside from "../components/aside/Aside.astro";
import TermGrid from "../components/list/TermGrid.astro";
import "../styles/pages/index.css";
---

<BaseLayout
  bigBanner="normal"
  heading="(theme.config.tags.tags_title ?: '全部标签')"
  title="(theme.config.tags.tags_title ?: '全部标签') + ' - ' + site.title"
  pageClass="page-tags"
>
  <div class="joe_main">
    <TermGrid kind="tags" />
  </div>
  <th-block th:if="${theme.config.aside.enable_tags_aside}">
    <Aside />
  </th-block>
</BaseLayout>
