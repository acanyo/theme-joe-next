---
import BaseLayout from "../layouts/BaseLayout.astro";
import Aside from "../components/aside/Aside.astro";
import PostItem from "../components/list/PostItem.astro";
import Pagination from "../components/list/Pagination.astro";
import Banner from "../components/home/Banner.astro";
import HotCategories from "../components/home/HotCategories.astro";
import "../styles/pages/index.less";
---

<BaseLayout pageClass="page-index" bigBanner="fullscreen">
  <div class="joe_main">
    <div class="joe_index">
      <th-block th:if="${theme.config.carousel.enable_banner and not #lists.isEmpty(theme.config.carousel.banner_data_group)}">
        <Banner />
      </th-block>
      <th-block th:if="${theme.config.home.enable_hot_category and not #lists.isEmpty(theme.config.home.data_hot_category)}">
        <HotCategories />
      </th-block>
      <div class="joe_index__article">
        <div class="joe_index__title">
          <ul class="joe_index__title-title passage-list-tabs default">
            <li class="item active">最新文章</li>
          </ul>
          <div
            class="joe_index__title-notice"
            th:if="${not #strings.isEmpty(theme.config.social.qq_group)}"
          >
            <i class="joe-font joe-icon-speaker" aria-hidden="true"></i>
            <a
              th:href="${theme.config.social.qq_group}"
              target="_blank"
              rel="noopener noreferrer nofollow"
              th:text="${theme.config.social.qq_text}"
            ></a>
          </div>
        </div>
        <div class="joe_index__list">
          <ul class="joe_list" data-joe-post-list>
            <th-block th:each="post, iter : ${posts.items}">
              <PostItem reveal />
            </th-block>
          </ul>
        </div>
      </div>
    </div>
    <th-block th:unless="${theme.config.home.enable_index_list_ajax}">
      <Pagination />
    </th-block>
    <div
      class="joe_load_container"
      th:if="${theme.config.home.enable_index_list_ajax and posts.hasNext()}"
    >
      <button
        type="button"
        class="joe_load"
        th:attr="data-next=@{${posts.nextUrl}}"
      >
        查看更多
      </button>
    </div>
  </div>
  <th-block th:if="${theme.config.aside.enable_aside}">
    <Aside />
  </th-block>
</BaseLayout>

<script>
  import "../scripts/pages/index";
</script>
