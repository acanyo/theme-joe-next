---
import BaseLayout from "../layouts/BaseLayout.astro";
import Aside from "../components/aside/Aside.astro";
import PostItem from "../components/list/PostItem.astro";
import Pagination from "../components/list/Pagination.astro";
import Banner from "../components/home/Banner.astro";
import HotCategories from "../components/home/HotCategories.astro";
import MomentsStack from "../components/home/MomentsStack.astro";
import OnThisDay from "../components/post/OnThisDay.astro";
import "../styles/pages/index.css";
import Icon from "../components/common/Icon.astro";
import "../styles/pages/moments-stack.css";
---

<BaseLayout seo="home" pageScript="index" pageClass="page-index" bigBanner="fullscreen">
  <div class="joe_main">
    <!-- 手机端紧凑首页（设置 home.compact_mobile）：精选推荐改为横向滑动一行、瞬间只显示最新一条 -->
    <div class="joe_index" th:classappend="${theme.config.home.compact_mobile ? 'joe_index--compact' : ''}">
      <th-block th:if="${theme.config.home.carousel and not #lists.isEmpty(theme.config.home.carousel_slides)}">
        <Banner />
      </th-block>
      <th-block th:if="${theme.config.home.featured and not #lists.isEmpty(theme.config.home.featured_items)}">
        <HotCategories />
      </th-block>
      <MomentsStack />
      <!-- 继续阅读（设置 home.resume_bar）：老访客上次读到一半的文章，由 features/resume-bar.ts 填入 -->
      <div class="joe_resume_bar" th:if="${theme.config.home.resume_bar}" data-joe-resume-bar hidden></div>
      <!-- 那年今日（设置 home.on_this_day）：往年今天写的文章，没有时不显示 -->
      <th-block th:if="${theme.config.home.on_this_day}" th:with="today = ${#dates.createNow()}">
        <OnThisDay />
      </th-block>
      <div class="joe_index__article">
        <div class="joe_index__title">
          <!-- 分类标签页（设置 home.category_tabs）：服务端输出全部分类，脚本按文章数保留前几个，点击在原地切换（scripts/pages/index.ts） -->
          <div
            class="joe_index__title-title passage-list-tabs default"
            role="tablist"
            aria-label="文章分类"
            data-joe-category-tabs
            th:attr="data-max=${theme.config.home.category_tabs_count ?: 5}"
          >
            <button
              type="button"
              role="tab"
              class="item active"
              aria-selected="true"
              th:attr="data-href=@{/}"
              th:text="${theme.config.home.list_sort == 'views' ? '最多阅读' : (theme.config.home.list_sort == 'updated' ? '最近更新' : '最新文章')}"
            >
              最新文章
            </button>
            <th-block
              th:if="${theme.config.home.category_tabs}"
              th:with="tabCats = ${categoryFinder.listAll().?[postCount > 0 and spec.hideFromList != true]}"
            >
              <button
                type="button"
                role="tab"
                class="item"
                aria-selected="false"
                th:each="cat : ${tabCats}"
                th:attr="data-href=@{${cat.status.permalink}}, data-count=${cat.postCount}"
                th:text="${cat.spec.displayName}"
              ></button>
            </th-block>
          </div>
          <div
            class="joe_index__title-notice"
            th:if="${not #strings.isEmpty(theme.config.home.qq_group)}"
          >
            <Icon name="notice" />
            <a
              th:href="${theme.config.home.qq_group}"
              target="_blank"
              rel="noopener noreferrer nofollow"
              th:text="${theme.config.home.qq_group_text}"
            ></a>
          </div>
        </div>
        <div class="joe_index__list">
          <!-- 排序（设置 home.list_sort）：默认沿用 Halo 首页的发布时间排序；其余按同一页码与每页条数重新查询，分页与加载更多不变 -->
          <ul
            class="joe_list"
            data-joe-post-list
            th:classappend="${theme.config.home.list_layout == 'cards' ? 'joe_list--cards' : ''}"
            th:with="homeSort = ${theme.config.home.list_sort == 'views' ? 'stats.visit,desc' : (theme.config.home.list_sort == 'updated' ? 'status.lastModifyTime,desc' : null)}, homePosts = ${homeSort == null ? posts.items : postFinder.list({page: posts.page, size: posts.size, sort: {'spec.pinned,desc', homeSort, 'metadata.creationTimestamp,asc'}}).items}"
          >
            <th-block th:each="post, iter : ${homePosts}">
              <PostItem reveal />
            </th-block>
          </ul>
        </div>
      </div>
    </div>
    <th-block th:unless="${theme.config.home.load_more}">
      <Pagination />
    </th-block>
    <div
      class="joe_load_container"
      th:if="${theme.config.home.load_more and posts.hasNext()}"
    >
      <button
        type="button"
        class="joe_load"
        th:attr="data-next=@{${posts.nextUrl}}"
      >
        查看更多
      </button>
    </div>
  </div>
  <th-block th:if="${theme.config.aside.enabled}">
    <Aside />
  </th-block>
</BaseLayout>
