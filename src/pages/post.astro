---
import BaseLayout from "../layouts/BaseLayout.astro";
import Actions from "../components/layout/Actions.astro";
import ArticleBody from "../components/post/ArticleBody.astro";
import AsideOperate from "../components/post/AsideOperate.astro";
import Breadcrumb from "../components/post/Breadcrumb.astro";
import CommentSection from "../components/post/CommentSection.astro";
import PostAds from "../components/post/PostAds.astro";
import PostAside from "../components/post/PostAside.astro";
import PostCopyright from "../components/post/PostCopyright.astro";
import PostHero from "../components/post/PostHero.astro";
import PostOperate from "../components/post/PostOperate.astro";
import PostNav from "../components/post/PostNav.astro";
import RelatedPosts from "../components/post/RelatedPosts.astro";
import OnThisDay from "../components/post/OnThisDay.astro";
import "../styles/pages/post.css";
import "../styles/pages/post-hero.css";
import "../styles/content/poster.css";
---

<BaseLayout seo="post"
  pageScript="post"
  readingProgress
  title="post.spec.title + ' - ' + site.title"
  pageClass="page-post"
>
  <!-- 沉浸头图是 CSS 背景图，浏览器要等样式解析完才发现它；提前预加载，头图（最大内容元素）能早一两百毫秒出现 -->
  <link
    slot="head"
    rel="preload"
    as="image"
    fetchpriority="high"
    th:if="${(theme.config.post.header_style ?: 'immersive') == 'immersive' and not #strings.isEmpty(post.spec.cover)}"
    th:href="${thumbnail.gen(post.spec.cover, 'l')}"
  />
  <PostHero slot="before" />
  <Breadcrumb slot="before" />

  <div class="joe_main joe_post">
    <AsideOperate />
    <ArticleBody subject="post">
      <PostOperate slot="footer" />
    </ArticleBody>
    <PostCopyright />
    <PostAds position="bottom" />

    <PostNav />
    <RelatedPosts />
    <!-- 那年今日（设置 post.on_this_day）：往年今天写的文章，没有时不显示 -->
    <th-block th:if="${theme.config.post.on_this_day}" th:with="today = ${#dates.createNow()}">
      <OnThisDay />
    </th-block>

    <CommentSection subject="post" kind="Post" />
  </div>

  <th-block th:if="${theme.config.aside.on_post}">
    <PostAside />
  </th-block>

  <div
    slot="before"
    class="joe_progress_bar"
    th:if="${theme.config.post.progress}"
    th:style="|background: ${theme.config.post.progress_color ?: 'var(--theme)'}|"
  ></div>
  <Actions slot="actions" editKind="post" toc />
</BaseLayout>
