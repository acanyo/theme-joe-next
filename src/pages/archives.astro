---
import BaseLayout from "../layouts/BaseLayout.astro";
import Aside from "../components/aside/Aside.astro";
import Pagination from "../components/list/Pagination.astro";
import "../styles/pages/archives.css";
import Icon from "../components/common/Icon.astro";
import ArchiveRow from "../components/list/ArchiveRow.astro";
import ArchiveHeatmap from "../components/list/ArchiveHeatmap.astro";

const TITLE = "theme.config.pages.archives_title ?: '文章归档'";
/**
 * 年 / 月归档（/archives/2025、/archives/2025/10）：Halo 只把筛选后的 archives 交给模板，不给年月本身；
 * 年月从 archives.prevUrl 里取（第 1 页时它就是当前路径，翻页后去掉 /page/n 也一样）。
 * 时间轴样式不分页，按这里取到的年月重新查询，否则会一直显示全部文章。
 */
const PERIOD_PATH = "archives.prevUrl?.replaceAll('/page/\\d+$', '')?.replaceAll('^.*?/(\\d{4})(/(\\d{2}))?$', '$1-$3')";
---

<BaseLayout
  pageScript="archives"
  bigBanner="normal"
  heading="(theme.config.pages.archives_title ?: '文章归档')"
  title={`(${TITLE}) + ' - ' + site.title`}
  pageClass="page-archives"
>
  <div class="joe_main">
    <div
      class="joe_index joe_archives__filing"
      th:with={`period = \${${PERIOD_PATH}}, periodYear = \${period != null and period.matches('\\d{4}-(\\d{2})?') ? period.substring(0, 4) : null}, periodMonth = \${periodYear != null and period.length() == 7 ? period.substring(5) : null}`}
    >
      <div class="title">
        <span th:if="${periodYear == null}" th:text={`\${${TITLE}}`}></span>
        <span th:unless="${periodYear == null}" class="period">
          <a th:href="@{/archives}" th:text={`\${${TITLE}}`}></a>
          <Icon name="chevron-right" />
          <span th:text="${periodMonth == null ? periodYear + ' 年' : periodYear + ' 年 ' + #conversions.convert(periodMonth, 'java.lang.Integer') + ' 月'}"></span>
        </span>
        <span class="total">共 <em th:text="${periodYear == null ? siteStatsFinder.getStats().post : archives.total}">0</em> 篇</span>
      </div>
      <div class="content">
        <th-block th:if="${theme.config.pages.archives_heatmap}" th:with="heatArchives = ${postFinder.archives(1, 9999).items}">
          <ArchiveHeatmap />
        </th-block>
        <div
          class="joe_archives__category animated fadeIn"
          th:if="${theme.config.pages.archives_categories}"
        >
          <div class="joe_archives-title">
            <Icon name="category" />分类
          </div>
          <ul class="joe_category-list">
            <li class="item" th:each="category : ${categoryFinder.listAll()}">
              <a
                class="link"
                th:href="@{${category.status.permalink}}"
                th:title="${category.spec.displayName}"
              >
                <span th:text="${category.spec.displayName}"></span>
                <em th:text="${category.status.visiblePostCount ?: 0}"></em>
              </a>
            </li>
          </ul>
        </div>

        <div
          class="joe_archives__wrapper animated fadeIn"
          th:with="byMonth = ${theme.config.pages.archives_group_by != 'year'}"
        >
          <th-block th:if="${theme.config.pages.archives_style == 'list'}">
            <div class="joe_archives-title">
              <Icon name="calendar" />列表
            </div>
            <p
              class="joe_archives__empty"
              th:if="${#lists.isEmpty(archives.items)}"
              th:text="${theme.config.pages.archives_empty ?: '暂无文章数据'}"
            ></p>
            <ul class="joe_archives-list">
              <th-block th:each="archive : ${archives.items}">
                <th-block th:each="month : ${archive.months}">
                  <li class="item" th:each="post : ${month.posts}">
                    <a
                      th:title="${post.spec.title}"
                      th:href="@{${post.status.permalink}}"
                      th:text="${post.spec.title}"
                    ></a>
                    <time th:text="${#dates.format(post.spec.publishTime, 'yyyy-MM-dd')}"></time>
                  </li>
                </th-block>
              </th-block>
            </ul>
            <Pagination result="archives" />
          </th-block>

          <th-block th:unless="${theme.config.pages.archives_style == 'list'}">
            <div class="joe_archives-title">
              <Icon name="timeline" />
              时间轴<em th:text="${byMonth ? '（月）' : '（年）'}"></em>
            </div>
            <ul
              class="joe_archives-timelist"
              th:with="allArchives = ${periodYear == null ? postFinder.archives(1, 9999) : postFinder.archives(1, 9999, periodYear, periodMonth)}"
            >
              <th-block th:each="archive : ${allArchives.items}">
                <th-block th:if="${byMonth}">
                  <li class="item" th:each="month : ${archive.months}">
                    <div class="wrapper">
                      <div class="panel in">
                        <span class="when" th:text="|${archive.year} 年 ${month.month} 月|"></span>
                        <em class="num" th:text="|${#lists.size(month.posts)} 篇|"></em>
                        <Icon name="chevron-down" />
                      </div>
                      <ol class="panel-body">
                        <li th:each="post : ${month.posts}">
                          <ArchiveRow />
                        </li>
                      </ol>
                    </div>
                  </li>
                </th-block>
                <li class="item" th:unless="${byMonth}">
                  <div class="wrapper">
                    <div class="panel in">
                      <span class="when" th:text="|${archive.year} 年|"></span>
                      <em class="num" th:text="|${#aggregates.sum(archive.months.![#lists.size(posts)])} 篇|"></em>
                      <Icon name="chevron-down" />
                    </div>
                    <ol class="panel-body">
                      <th-block th:each="month : ${archive.months}">
                        <li th:each="post : ${month.posts}">
                          <ArchiveRow />
                        </li>
                      </th-block>
                    </ol>
                  </div>
                </li>
              </th-block>
            </ul>
          </th-block>
        </div>
      </div>
    </div>
  </div>
  <th-block th:if="${theme.config.aside.on_archives}">
    <Aside />
  </th-block>
</BaseLayout>
