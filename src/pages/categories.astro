---
import BaseLayout from "../layouts/BaseLayout.astro";
import Aside from "../components/aside/Aside.astro";
import TermGrid from "../components/list/TermGrid.astro";
import "../styles/pages/index.css";
---

<BaseLayout
  bigBanner="normal"
  heading="(theme.config.pages.categories_title ?: '全部分类')"
  title="(theme.config.pages.categories_title ?: '全部分类') + ' - ' + site.title"
  pageClass="page-categories"
>
  <div class="joe_main">
    <TermGrid kind="categories" />
  </div>
  <th-block th:if="${theme.config.aside.on_categories}">
    <Aside />
  </th-block>
</BaseLayout>
