---
import BaseLayout from "../layouts/BaseLayout.astro";
import Aside from "../components/aside/Aside.astro";
import Icon from "../components/common/Icon.astro";
import { responsiveImage, SIZES } from "../config/images";
import "../styles/pages/photos.css";
---

<BaseLayout seo="photos"
  pageScript="photos"
  title="(theme.config.pages.photos_title ?: '我的图库') + ' - ' + site.title"
  pageClass="page-photos"
>
  <div class="joe_main">
    <div class="joe_photos__type">
      <h1 class="joe_photos__type-title">
        <Icon name="image" />&nbsp;
        <span th:text="${theme.config.pages.photos_title ?: '我的图库'}"></span>
      </h1>
      <nav class="joe_photos__filter" aria-label="图库分组">
        <ul>
          <li class="active">
            <button type="button" data-joe-photo-filter="*">
              全部
            </button>
          </li>
          <li th:each="group : ${groups}">
            <button
              type="button"
              th:attr="data-joe-photo-filter=${group.metadata.name}"
              th:text="${group.spec.displayName}"
            ></button>
          </li>
        </ul>
      </nav>
    </div>
    <div class="wrapper">
      <div
        class="joe_photos__grid"
        id="image-grid"
        th:attr="data-next=${photos.hasNext() ? photos.nextUrl : ''}"
        th:style="|--photos-gap: ${theme.config.pages.photos_gap ?: 10}px|"
      >
        <figure
          class="grid-item"
          th:each="photo : ${photos.items}"
          th:attr="data-group=${photo.spec.groupName}"
          th:classappend="${theme.config.effects.list_animation ? 'joe-reveal' : ''}"
          th:data-reveal="${theme.config.effects.list_animation_name}"
        >
          <img
            loading="lazy"
            {...responsiveImage("photo.spec.url", SIZES.photo, ["s", "m", "l"])}
            th:attr="data-full=${photo.spec.url}"
            th:alt="${photo.spec.displayName}"
            data-fallback="image"
          />
          <figcaption
            th:if="${not #strings.isEmpty(photo.spec.displayName)}"
            th:text="${photo.spec.displayName}"
          ></figcaption>
        </figure>
      </div>
      <div class="joe_loading" th:if="${photos.hasNext()}">
        <img th:src="@{/assets/images/loading-ball.svg}" alt="加载中" />
      </div>
    </div>
  </div>
  <th-block th:if="${theme.config.aside.on_photos}">
    <Aside />
  </th-block>
</BaseLayout>
