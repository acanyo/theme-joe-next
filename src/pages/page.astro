---
import BaseLayout from "../layouts/BaseLayout.astro";
import Actions from "../components/layout/Actions.astro";
import PageAside from "../components/aside/PageAside.astro";
import ArticleBody from "../components/post/ArticleBody.astro";
import CommentSection from "../components/post/CommentSection.astro";
import "../styles/pages/post.css";
---

<BaseLayout seo="page"
  pageScript="post"
  title="singlePage.spec.title"
  pageClass="page-post page-sheet"
>
  <div class="joe_main joe_post">
    <ArticleBody subject="singlePage" />
    <CommentSection subject="singlePage" kind="SinglePage" />
  </div>
  <PageAside />
  <Actions slot="actions" editKind="page" />
</BaseLayout>
